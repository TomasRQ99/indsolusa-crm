# Copy to .env and adjust. Never commit .env.
DATABASE_URL="postgresql://crm:crm@localhost:5432/crm?schema=public"

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET="replace-me-with-a-long-random-string-of-32-plus-chars"

# ---- Outgoing email: sales@indsolusa.com ----
MAIL_FROM="sales@indsolusa.com"

# Preferred for Microsoft 365: Microsoft Graph via an Entra app registration
# with the Mail.Send application permission (admin consent granted).
# When these three are set, the SMTP settings below are ignored.
GRAPH_TENANT_ID=""
GRAPH_CLIENT_ID=""
GRAPH_CLIENT_SECRET=""

# Fallback: SMTP login (only used when the GRAPH_* values are empty)
# IndSolUSA uses Microsoft 365 from GoDaddy:
SMTP_HOST="smtp.office365.com"
SMTP_PORT="587"
SMTP_SECURE="false"
# (GoDaddy "Professional Email" would instead be:
#   SMTP_HOST="smtpout.secureserver.net"  SMTP_PORT="465"  SMTP_SECURE="true")
SMTP_USER="sales@indsolusa.com"
SMTP_PASS="the-mailbox-password"
# Optional comma-separated BCC. Graph already saves to Sent Items; with SMTP,
# set this to sales@indsolusa.com to keep a copy in the mailbox.
MAIL_BCC=""

# ---- First admin login, created by `npm run db:seed` ----
SEED_ADMIN_EMAIL="sales@indsolusa.com"
SEED_ADMIN_PASSWORD="ChangeMe123!"
# Set to "true" to also load demo users and sample accounts/deals.
SEED_DEMO="false"
