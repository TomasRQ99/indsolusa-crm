generator client {
  provider        = "prisma-client-js"
  // One SQL query per findMany (LATERAL JOINs) instead of one round-trip per relation level:
  // pages with nested includes need far fewer trips to the database (Neon).
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Business role names the team recognizes (user decision 2026-11-09). Old → new: ADMIN → GERENCIA,
// MANAGER → DIRECTOR_COMERCIAL, REP → NEGOCIADOR_COMERCIAL. NEGOCIADOR_OPERATIVO and FINANZAS are new.
enum Role {
  GERENCIA
  DIRECTOR_COMERCIAL
  NEGOCIADOR_COMERCIAL
  NEGOCIADOR_OPERATIVO
  FINANZAS
  MARKETING
  /// Administración (decision O-02, 2026-11-10): same powers as Finanzas for now; approves purchases.
  ADMINISTRACION
}

enum Lang {
  ES
  EN
}

enum DealStage {
  LEAD
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum TaskStatus {
  OPEN
  DONE
}

enum ActivityType {
  CALL
  MEETING
  EMAIL
  NOTE
}

enum CommissionHalf {
  SALE
  COLLECTION
}

// Users are deactivated, never deleted, so ownership history stays intact.
model User {
  id                 String                @id @default(cuid())
  cashBlockers       CashBlocker[]         @relation("CashBlockerOwner")
  creditRequested    CreditReviewRequest[] @relation("CreditRequester")
  creditDecided      CreditReviewRequest[] @relation("CreditDecider")
  email              String                @unique
  name               String
  passwordHash       String
  role               Role                  @default(NEGOCIADOR_COMERCIAL)
  active             Boolean               @default(true)
  lang               Lang                  @default(ES)
  // Length of a normal working day, used by Mi Plan to size capacity.
  workdayMinutes     Int                   @default(570)
  /// Authorisation level of the person (company ranges by level): EMPRENDEDOR | JUNIOR | SENIOR, or null when not set
  authLevel          String?
  teamsLed           Team[]                @relation("TeamLeader")
  teamMemberships    TeamMember[]
  // Outlook calendar of the person's own mailbox (login email), read and written via Microsoft Graph.
  outlookConnectedAt DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  accounts         Account[]
  deals            Deal[]
  tasks            Task[]
  activities       Activity[]
  goalTargets      GoalTarget[]
  visits           VisitPlan[]            @relation("VisitOwner")
  missions         CommercialMission[]    @relation("MissionOwner")
  coveredBy        CoverageAssignment[]   @relation("CoverageOriginal")
  covering         CoverageAssignment[]   @relation("CoverageActing")
  backupFor        RelationshipBackup[]   @relation("RelationshipBackupUser")
  opsExceptions    OperationalException[] @relation("ExceptionOwner")
  purchaseRequests PurchaseRequirement[]  @relation("PrRequester")

  paymentsRequested   SupplierPayment[]      @relation("PaymentRequester")
  paymentsVerified    SupplierPayment[]      @relation("PaymentVerifier")
  paymentsApproved    SupplierPayment[]      @relation("PaymentApprover")
  paymentsExecuted    SupplierPayment[]      @relation("PaymentExecutor")
  invoicesIssued      Invoice[]
  promisesRecorded    PaymentPromise[]
  cashRecorded        CustomerPayment[]      @relation("CashRecorder")
  billingRequests     BillingRequest[]
  cashReconciled      CustomerPayment[]      @relation("CashReconciler")
  commissionsEarned   CommissionEntry[]      @relation("CommissionOwner")
  commissionShares    CommissionAllocation[] @relation("CommissionShare")
  commissionsApproved CommissionEntry[]      @relation("CommissionApprover")
  creditExceptions    Deal[]                 @relation("CreditException")
  suppliersVerified   Supplier[]
  journeyViews        JourneyView[]
  commMessages        CommMessage[]
  commDecisions       CommItem[]
  quotesCreated       Quote[]
  explorations        Exploration[]          @relation("ExplorationOwner")
  futuresOwned        FutureOpportunity[]    @relation("FutureOwner")
}

model Account {
  id        String   @id @default(cuid())
  name      String
  /// Our own company as the holder of stock purchases; never a customer.
  internal  Boolean  @default(false)
  industry  String?
  website   String?
  phone     String?
  address   String?
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Commercial and billing terms
  taxId                 String?
  taxDataComplete       Boolean   @default(false)
  creditLimit           Decimal?  @db.Decimal(14, 2)
  paymentTermsDays      Int       @default(30)
  requiresReceptionCode Boolean   @default(false)
  requiresPortal        Boolean   @default(false)
  portalValidUntil      DateTime?
  isDemo                Boolean   @default(false)
  // Default language of the documents sent to this customer (Quote, Invoice).
  docLang               Lang      @default(EN)
  // Billing profile: whether the customer accepts one invoice per partial delivery, and who receives invoices.
  allowsPartialBilling  Boolean   @default(true)
  billingContact        String?

  contacts             Contact[]
  outboundMails        OutboundMail[]
  deals                Deal[]
  tasks                Task[]
  activities           Activity[]
  invoices             Invoice[]
  payments             CustomerPayment[]
  threads              CommThread[]
  documents            AccountDocument[]
  plants               Plant[]
  marketSignals        MarketSignal[]
  gaps                 KnowledgeGap[]
  whiteSpaces          WhiteSpace[]
  futures              FutureOpportunity[]
  aliases              AccountAlias[]
  insights             AccountInsight[]
  employments          Employment[]
  marketCompany        MarketCompany?
  payBehaviors         PaymentBehaviorSnapshot[]
  paymentMap           PaymentMap?
  creditReviews        CreditReviewRequest[]
  openLoops            OpenLoop[]
  prepared             PreparedMessage[]
  visits               VisitPlan[]
  backup               RelationshipBackup?
  deliveryRequirements DeliveryRequirement[]

  @@index([ownerId])
  @@index([name])
}

// Company documents of a customer (RUT, Cámara de Comercio certificate, others).
// `extracted` keeps what SOLU read from the file, so a person can see where a field came from.
model AccountDocument {
  id           String   @id @default(cuid())
  accountId    String
  account      Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  kind         String // RUT | CAMARA | OTHER
  name         String
  mime         String
  size         Int
  data         Bytes
  extracted    Json?
  uploadedById String?
  createdAt    DateTime @default(now())

  @@index([accountId])
}

model Contact {
  id           String             @id @default(cuid())
  paymentRoles PaymentMapPerson[]
  firstName    String
  lastName     String
  email        String?
  phone        String?
  title        String?
  accountId    String?
  account      Account?           @relation(fields: [accountId], references: [id], onDelete: SetNull)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  deals       Deal[]
  tasks       Task[]
  activities  Activity[]
  threads     CommThread[]
  employments Employment[]
  personNotes PersonNote[]
  openLoops   OpenLoop[]
  prepared    PreparedMessage[]

  @@index([accountId])
  @@index([lastName, firstName])
}

// A Deal is the commercial heart of a Journey (J-YYMM-####): need, customer PO,
// purchase, delivery, invoice, cash and the customer's result.
model Deal {
  id        String    @id @default(cuid())
  code      String?   @unique
  title     String
  amount    Decimal   @default(0) @db.Decimal(14, 2)
  stage     DealStage @default(LEAD)
  closeDate DateTime?
  accountId String
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contactId String?
  contact   Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  ownerId   String
  owner     User      @relation(fields: [ownerId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  desiredResult         String?
  /// C-02: which of our companies sells on this Journey (SellingEntity.key). Fixed once a quote was presented.
  sellerKey             String       @default("USA")
  /// Internal holder for a stock-only purchase (no customer behind it). Hidden from sales screens; exists so the
  /// order, payments, shipment and receipt work exactly like any other purchase.
  internal              Boolean      @default(false)
  customerPo            String?
  poAcceptedAt          DateTime?
  promisedDate          DateTime?
  promiseText           String?
  supplierCost          Decimal      @default(0) @db.Decimal(14, 2)
  freightCost           Decimal      @default(0) @db.Decimal(14, 2)
  otherCosts            Decimal      @default(0) @db.Decimal(14, 2)
  nextMove              String?
  nextMoveDate          DateTime?
  waitingFor            String?
  waitingUntil          DateTime?
  resultAchievedAt      DateTime?
  offerValidUntil       DateTime?
  creditExceptionById   String?
  creditExceptionBy     User?        @relation("CreditException", fields: [creditExceptionById], references: [id])
  creditExceptionAt     DateTime?
  creditExceptionNote   String?
  // Journey Workspace: what is needed, how it is measured and what it costs not to solve it.
  needSpecs             String?
  neededBy              DateTime?
  successMeasure        String?
  impactIfNot           String?
  sourcingNote          String?
  incoterm              String?
  paymentTerms          String?
  quoteSentAt           DateTime?
  resultNote            String?
  // Result & Closure: desired result vs actual result, confirmed with evidence (delivery is not the result).
  resultState           ResultState  @default(PENDING)
  actualResult          String?
  reliefNote            String?
  resultPendingNote     String?
  resultConfirmedAt     DateTime?
  resultConfirmedByName String?
  closedAt              DateTime?
  closedByName          String?
  closureSummary        String?
  closureLearning       String?
  closureNoSignalReason String?
  // Promise performance: the first promise is kept; later changes count as revisions (when, and why).
  originalPromisedDate  DateTime?
  promiseRevisions      Int          @default(0)
  promiseRevisedAt      DateTime?
  promiseChangeCause    String?
  // Mercado M6 (§12): a Need confirmed from Mercado keeps where it came from and what Mercado knew then.
  explorationId         String?
  exploration           Exploration? @relation(fields: [explorationId], references: [id], onDelete: SetNull)
  plantId               String?
  plant                 Plant?       @relation(fields: [plantId], references: [id], onDelete: SetNull)
  /// note:<id> | future:<id> | signal:<id> — the evidence the Need was confirmed from
  originRef             String?
  /// Frozen copy of the inherited context at confirmation (items with their source ids).
  needContext           Json?

  // Comercial C1 · Technical & Scope
  scopeLines         ScopeLine[]
  technicalFacts     TechnicalFact[]
  scopeConfirmations ScopeConfirmation[]

  resultEvidence        ResultEvidence[]
  recoveries            Recovery[]
  continuity            ContinuitySignal[]
  tasks                 Task[]
  views                 JourneyView[]
  threads               CommThread[]
  quotes                Quote[]
  customerPos           CustomerPO[]
  activities            Activity[]
  items                 DealItem[]
  supplierPos           SupplierPO[]
  rfqs                  Rfq[]
  shipments             Shipment[]
  deliveries            Delivery[]
  invoices              Invoice[]
  billingRequests       BillingRequest[]
  cashBlockers          CashBlocker[]
  creditReviews         CreditReviewRequest[]
  // Comercial C5 · Solution Case & Proposal
  solutionCase          SolutionCase?
  // Comercial C6 · PO allocations and dispatch
  poAllocations         PoAllocation[]
  dispatches            DispatchInstruction[]
  // Comercial C4 · Sourcing & Supply
  sourcingSearches      SourcingSearch[]
  supplyOptions         SupplyOption[]
  supplyBases           SupplyBasis[]
  opsExceptions         OperationalException[]
  purchaseRequirements  PurchaseRequirement[]
  purchaseAllocations   PurchaseAllocation[]
  savings               SavingsEntry[]
  stockLots             StockLot[]
  dispatchOrders        DispatchOrder[]
  costs                 DealCost[]
  commissionAllocations CommissionAllocation[]
  authorizations        DealAuthorization[]
  /// module 11 §44.2: OPEN | SUBSTANTIAL | FINAL
  economicsState        String                 @default("OPEN")
  economicsNote         String?
  economicsByName       String?
  economicsAt           DateTime?
  /// the three views and the bridge as they were when marked FINAL
  economicsFinal        Json?
  /// module 11 §40: UPON_ORDER | UPON_DELIVERY | UPON_ACCEPTANCE | MILESTONE | ADVANCE_BALANCE | RECURRING
  billingBasis          String                 @default("UPON_DELIVERY")
  warranties            Warranty[]
  customerClaims        CustomerClaim[]
  productExperiences    ProductExperience[]

  @@index([stage])
  @@index([ownerId])
  @@index([accountId])
}

enum ResultState {
  PENDING
  PARTIAL
  ACHIEVED
  NOT_ACHIEVED
  NO_LONGER_RELEVANT
}

// What the customer said, a technical fact, a visit or a measurement. It supports, partly supports
// or contradicts the desired result. Only evidence (never the delivery itself) confirms a result.
model ResultEvidence {
  id             String   @id @default(cuid())
  dealId         String
  deal           Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  kind           String
  stance         String
  text           String
  who            String?
  source         String?
  at             DateTime
  recordedByName String
  createdAt      DateTime @default(now())

  @@index([dealId])
}

// Opened when the product arrived but the result is at risk or wasn't achieved.
model Recovery {
  id             String    @id @default(cuid())
  dealId         String
  deal           Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  openedAt       DateTime  @default(now())
  openedByName   String
  whatChanged    String
  impact         String
  // Material cause: SPEC / SUPPLIER / LOGISTICS / CUSTOMER / COST / OTHER
  cause          String?
  options        Json
  selectedKey    String?
  selectedAt     DateTime?
  selectedByName String?
  selectedNote   String?
  expectedBy     DateTime?
  resolvedAt     DateTime?
  outcome        String?
  outcomeNote    String?

  @@index([dealId])
}

// A legitimate reason to come back (signal) or a concrete condition/date to act on (trigger).
// Not an opportunity: it creates no Journey and no pipeline value.
model ContinuitySignal {
  id            String    @id @default(cuid())
  dealId        String
  deal          Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  kind          String
  what          String
  basis         String
  triggerOn     DateTime?
  triggerEvent  String?
  createdByName String
  createdAt     DateTime  @default(now())
  resolvedAt    DateTime?

  @@index([dealId])
}

// Observed knowledge about a product, keyed by its code: alias, packing, compatibility, spec.
// Every fact keeps where it came from and when it was observed (freshness + provenance).
model ProductFact {
  id             String   @id @default(cuid())
  code           String
  kind           String
  text           String
  source         String?
  observedAt     DateTime
  recordedByName String
  createdAt      DateTime @default(now())

  @@index([code])
}

// ---------- Spare Parts Localization L3: supplier offers ----------
// A supplier's official quote or proforma invoice (the file is kept as evidence). Its lines become SupplierOffers.
// Bank details printed on a proforma are NEVER used: payments only use the supplier's verified bank profile.
model SupplierDoc {
  id             String          @id @default(cuid())
  supplierId     String
  supplier       Supplier        @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  kind           String // QUOTE | PROFORMA
  reference      String? // the supplier's own number
  issuedAt       DateTime?
  validUntil     DateTime?
  currency       String?
  incoterm       String?
  leadText       String?
  paymentTerms   String?
  fileName       String
  mime           String
  size           Int
  data           Bytes
  text           String? // text read from the PDF (audit / re-reading)
  extracted      Json? // what SOLU read (header + candidate lines), shown for review
  bankWarning    String? // the document shows bank details that don't match the verified profile
  rfqRecipientId String?         @unique
  rfqRecipient   RfqRecipient?   @relation(fields: [rfqRecipientId], references: [id], onDelete: SetNull)
  reviewedAt     DateTime?
  createdByName  String
  createdAt      DateTime        @default(now())
  offers         SupplierOffer[]

  @@index([supplierId])
}

// One price for one part from one supplier, with its conditions and where it came from.
model SupplierOffer {
  id             String         @id @default(cuid())
  partId         String
  part           Part           @relation(fields: [partId], references: [id], onDelete: Cascade)
  supplierId     String
  supplier       Supplier       @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  docId          String?
  doc            SupplierDoc?   @relation(fields: [docId], references: [id], onDelete: SetNull)
  codeAsQuoted   String
  description    String?
  qty            Int?
  unitPrice      Decimal        @db.Decimal(14, 4)
  currency       String
  leadDaysMin    Int?
  leadDaysMax    Int?
  leadText       String?
  validUntil     DateTime?
  incoterm       String?
  condition      String? // NEW | REFURBISHED | USED
  source         String?
  recordedByName String
  createdAt      DateTime       @default(now())
  supplyOptions  SupplyOption[]

  @@index([partId])
  @@index([supplierId])
}

// A public web page or distributor API result found for a part (L5). Evidence only: never a price
// we committed to. Kept with the date it was read, so stale data shows as stale.
model WebSource {
  id           String   @id @default(cuid())
  partId       String
  part         Part     @relation(fields: [partId], references: [id], onDelete: Cascade)
  kind         String // PAGE | MOUSER | DIGIKEY | SITEMAP
  url          String
  host         String
  title        String?
  mpnSeen      String?
  brand        String?
  matched      Boolean  @default(false) // the page/API shows this exact part number
  price        Decimal? @db.Decimal(14, 4)
  currency     String?
  priceBreaks  Json? // [{qty, price}]
  stock        Int?
  availability String?
  leadText     String?
  lifecycle    String?
  datasheetUrl String?
  fetchedAt    DateTime @default(now())
  savedByName  String?
  createdAt    DateTime @default(now())

  @@unique([partId, url])
  @@index([partId])
}

// Cache of polite fetches: robots.txt, sitemaps and pages (so we never hammer a site).
model WebCache {
  url         String   @id
  status      Int
  contentType String?
  body        String?
  fetchedAt   DateTime @default(now())
}

// A request for quotation sent from sales@ to several suppliers (one separate email each).
model Rfq {
  /// One key per RFQ form: a double click never creates two RFQs.
  idemKey       String?        @unique
  id            String         @id @default(cuid())
  code          String         @unique
  dealId        String?
  deal          Deal?          @relation(fields: [dealId], references: [id], onDelete: SetNull)
  items         Json // [{partId, mpn, name, brand, qty}]
  lang          String         @default("EN")
  neededBy      DateTime?
  /// Only when the Journey is really urgent does the email say URGENT (no artificial pressure).
  urgent        Boolean        @default(false)
  notes         String?
  subject       String
  body          String
  /// C4 (§7): what we asked the supplier and why — [{key, level}]
  asked         Json?
  createdById   String
  createdByName String
  createdAt     DateTime       @default(now())
  recipients    RfqRecipient[]
}

model RfqRecipient {
  id         String       @id @default(cuid())
  rfqId      String
  rfq        Rfq          @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  supplierId String
  supplier   Supplier     @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  email      String
  status     String // SENT | FAILED | ANSWERED | DECLINED
  sentAt     DateTime?
  error      String?
  answeredAt DateTime?
  /// E2: first reply seen in the sales@ inbox (not the same as a registered quote).
  repliedAt  DateTime?
  doc        SupplierDoc?

  @@index([rfqId])
  @@index([supplierId])
}

// Every paid AI call, with its cost, so the monthly cap (AI_MONTHLY_CAP_USD) can be enforced and shown.
model AiUsage {
  id           String   @id @default(cuid())
  feature      String // PART_PHOTO, ...
  model        String
  inputTokens  Int
  outputTokens Int
  costUsd      Decimal  @db.Decimal(10, 5)
  ok           Boolean  @default(true)
  userName     String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

// ---------- Spare Parts Localization: the parts catalog ----------
// One canonical record per part (schema.org Product-style fields). Quote, Journey and PO lines
// keep their free-text codes; they are matched to a Part through its normalized code and aliases.
model Part {
  id               String   @id @default(cuid())
  mpn              String // canonical part number, as displayed
  mpnKey           String   @unique // normalized: upper case, letters and digits only
  brand            String?
  name             String // description (Spanish)
  nameEn           String?
  category         String? // product line: MECANICA, ELECTRONICA, ELECTRICA, NEUMATICA, HIDRAULICA, METROLOGIA, AUTOMATIZACION, LUBRICACION, INSTRUMENTAL
  gtin             String?
  condition        String? // NEW | REFURBISHED | USED
  lifecycle        String? // ACTIVE | DISCONTINUED | OBSOLETE
  specs            Json? // [{k, v}]
  compatibleModels String[] @default([])
  notes            String?
  // A duplicate merged into its canonical part keeps existing (so old links still resolve).
  mergedIntoId     String?
  mergedInto       Part?    @relation("PartMerge", fields: [mergedIntoId], references: [id])
  merged           Part[]   @relation("PartMerge")
  createdByName    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  aliases           PartAlias[]
  offers            SupplierOffer[]
  webSources        WebSource[]
  logisticsObs      LogisticsObservation[]
  importExperiences ImportExperience[]

  @@index([brand])
  @@index([mergedIntoId])
  @@index([mpnKey(ops: raw("gin_trgm_ops"))], type: Gin, map: "Part_mpnKey_trgm")
}

// Every other number or name the same part is known by, with where it came from.
model PartAlias {
  id            String   @id @default(cuid())
  partId        String
  part          Part     @relation(fields: [partId], references: [id], onDelete: Cascade)
  code          String
  codeKey       String
  kind          String // OEM | AFTERMARKET | CROSSREF | SUPERSEDED | VARIANT | MERGED | NAME
  brand         String?
  source        String?
  createdByName String?
  createdAt     DateTime @default(now())

  @@unique([partId, codeKey])
  @@index([codeKey])
  @@index([codeKey(ops: raw("gin_trgm_ops"))], type: Gin, map: "PartAlias_codeKey_trgm")
}

// Product health of SOLU itself (never of people): a person reports that SOLU made them
// re-enter something it already knew, warned without need, or failed to warn.
model ProductSignal {
  id             String    @id @default(cuid())
  kind           String // REENTRY / ATTENTION_NOISE / ATTENTION_MISSED
  screen         String?
  note           String
  reportedByName String
  createdAt      DateTime  @default(now())
  resolvedAt     DateTime?

  @@index([createdAt])
}

model DealItem {
  id          String  @id @default(cuid())
  dealId      String
  deal        Deal    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  qty         Int
  code        String?
  description String
  unitPrice   Decimal @db.Decimal(14, 2)

  deliveryLines DeliveryLine[]

  @@index([dealId])
}

// Last time each person opened a Journey, to answer "what changed since I last looked?".
model JourneyView {
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dealId     String
  deal       Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  seenAt     DateTime
  prevSeenAt DateTime?

  @@id([userId, dealId])
}

model Task {
  id              String       @id @default(cuid())
  title           String
  dueDate         DateTime?
  status          TaskStatus   @default(OPEN)
  completedAt     DateTime?
  estimateMinutes Int?
  plannedFor      DateTime?
  scheduledAt     DateTime?
  outlookEventId  String?
  assigneeId      String
  assignee        User         @relation(fields: [assigneeId], references: [id])
  accountId       String?
  account         Account?     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contactId       String?
  contact         Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  dealId          String?
  deal            Deal?        @relation(fields: [dealId], references: [id], onDelete: Cascade)
  explorationId   String?
  exploration     Exploration? @relation(fields: [explorationId], references: [id], onDelete: Cascade)
  createdAt       DateTime     @default(now())

  @@index([assigneeId, status])
}

model Activity {
  id         String       @id @default(cuid())
  type       ActivityType
  subject    String
  body       String?
  occurredAt DateTime     @default(now())
  userId     String
  user       User         @relation(fields: [userId], references: [id])
  accountId  String?
  account    Account?     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contactId  String?
  contact    Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  dealId     String?
  deal       Deal?        @relation(fields: [dealId], references: [id], onDelete: Cascade)
  // Journey Workspace: which phase this fact feeds, where it came from, and whether it still needs confirming.
  phase      String?
  source     String?
  uncertain  Boolean      @default(false)
  // Comercial C7 §39: what this contact produced (INFO, NEED, RELATIONSHIP, DECISION_MAKER, NEXT_MOVE, OBJECTION,
  // DECISION_WINDOW). Null = nothing useful (an attempt with no answer), so it never counts as a useful contact.
  valueKind  String?

  @@index([accountId, occurredAt])
  @@index([occurredAt])
}

// ---------- Suppliers and purchasing ----------

model Supplier {
  id               String    @id @default(cuid())
  name             String
  country          String?
  currency         String    @default("USD")
  email            String?
  // Phone registered when the supplier was onboarded; used for independent verification.
  phone            String?
  // Verified bank profile. Only changed through an independent verification.
  bankBeneficiary  String?
  bankName         String?
  bankAccount      String?
  bankSwift        String?
  bankVerifiedAt   DateTime?
  bankVerifiedById String?
  bankVerifiedBy   User?     @relation(fields: [bankVerifiedById], references: [id])
  isDemo           Boolean   @default(false)
  createdAt        DateTime  @default(now())
  // Commercial terms the supplier usually gives (used to prepare the Supplier PO and its payment milestones).
  paymentTerms     String?
  advancePct       Int       @default(100)
  transitDays      Int?
  // Public website, used to look for part pages via its sitemap (robots.txt is always obeyed).
  website          String?
  /// NIT / tax ID. Same NIT as a customer = the same organization with both roles (Mercado §4.3).
  taxId            String?

  pos                  SupplierPO[]
  docs                 SupplierDoc[]
  offers               SupplierOffer[]
  rfqRecipients        RfqRecipient[]
  outboundMails        OutboundMail[]
  supplyOptions        SupplyOption[]
  logisticsObs         LogisticsObservation[]
  purchaseRequirements PurchaseRequirement[]
}

model SupplierPO {
  id               String    @id @default(cuid())
  code             String    @unique
  dealId           String
  deal             Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  supplierId       String
  supplier         Supplier  @relation(fields: [supplierId], references: [id])
  amount           Decimal   @db.Decimal(14, 2)
  currency         String    @default("USD")
  confirmedAt      DateTime?
  shippedAt        DateTime?
  eta              DateTime?
  receivedAt       DateTime?
  // Carrier's own ETA (a separate truth from SOLU's expected date and the customer promise).
  carrierName      String?
  tracking         String?
  carrierEta       DateTime?
  carrierEtaAt     DateTime?
  carrierEtaSource String?
  createdAt        DateTime  @default(now())
  // Versioned document: released terms are not edited; a change creates the next version.
  version          Int       @default(1)
  releasedAt       DateTime?
  releasedByName   String?
  incoterm         String?
  terms            String?
  proformaRef      String?
  shipBy           DateTime?
  costNote         String?
  history          Json?
  // O3 · separate facts (§14.2): authorized = releasedAt, then sent, acknowledged, confirmed (confirmedAt).
  sentAt           DateTime?
  sentHow          String?
  sentByName       String?
  ackAt            DateTime?
  ackNote          String?
  /// The supplier's FIRST quote for this order: the baseline every saving is measured against (decision O-10).
  firstQuoteAmount Decimal?  @db.Decimal(14, 2)
  firstQuoteRef    String?
  negotiationNote  String?

  lines         SupplierPOLine[]
  requirements  PaymentRequirement[]
  payments      SupplierPayment[]
  shipments     Shipment[]
  confirmations SupplierConfirmation[]
  savings       SavingsEntry[]
  commitments   SupplierCommitment[]
  freight       FreightRequirement?
  receipts      GoodsReceipt[]
  /// STOCK | MANUFACTURED | SERVICE | REPAIR: which milestones apply (§23)
  orderKind     String?

  @@index([dealId])
}

model SupplierPayment {
  id                   String              @id @default(cuid())
  supplierPoId         String
  supplierPo           SupplierPO          @relation(fields: [supplierPoId], references: [id], onDelete: Cascade)
  amount               Decimal             @db.Decimal(14, 2)
  currency             String              @default("USD")
  amountUsd            Decimal?            @db.Decimal(14, 2)
  reason               String
  dueBy                DateTime?
  // Bank data as it appears on the supplier's proforma / invoice / instruction.
  docBeneficiary       String?
  docBankName          String?
  docAccount           String?
  docSwift             String?
  docSource            String?
  requestedById        String
  requestedBy          User                @relation("PaymentRequester", fields: [requestedById], references: [id])
  verifiedById         String?
  verifiedBy           User?               @relation("PaymentVerifier", fields: [verifiedById], references: [id])
  verifiedAt           DateTime?
  verificationNote     String?
  approvedById         String?
  approvedBy           User?               @relation("PaymentApprover", fields: [approvedById], references: [id])
  approvedAt           DateTime?
  executedById         String?
  executedBy           User?               @relation("PaymentExecutor", fields: [executedById], references: [id])
  executedAt           DateTime?
  executedRef          String?
  createdAt            DateTime            @default(now())
  // Payment Requirement this request pays (milestone), and the separate execution attempts.
  requirementId        String?
  requirement          PaymentRequirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  dupCheckedByName     String?
  dupCheckNote         String?
  // O4 §21: after the bank debit, two more separate facts: the supplier has the money, and the supplier released the order.
  supplierReceivedAt   DateTime?
  supplierReceivedNote String?
  orderReleasedAt      DateTime?
  orderReleasedNote    String?
  executions           PaymentExecution[]

  @@index([supplierPoId])
}

// ---------- Delivery, invoicing and cash ----------

model Delivery {
  id             String   @id @default(cuid())
  code           String   @unique
  dealId         String
  deal           Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  deliveredAt    DateTime
  place          String?
  deliveredBy    String?
  receivedByName String?
  podReceived    Boolean  @default(false)
  receptionCode  String?
  notes          String?
  createdAt      DateTime @default(now())

  lines           DeliveryLine[]
  shipment        Shipment?
  invoice         Invoice?
  billingRequests BillingRequest[]
  dispatchOrder   DispatchOrder?
  /// O8 customer entry reference: MIGO | GR | ENTRY | WAREHOUSE | CUSTOM (the number itself is receptionCode)
  receptionKind   String?
  receptionAt     DateTime?

  @@index([dealId])
}

// Billing evidence asked of the customer (POD, receiving code, PO, portal, tax data).
// Resolved when the evidence is recorded, not when someone says it was sent.
model BillingRequest {
  id            String    @id @default(cuid())
  dealId        String
  deal          Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  deliveryId    String?
  delivery      Delivery? @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  kind          String
  sentTo        String?
  note          String?
  requestedAt   DateTime  @default(now())
  requestedById String
  requestedBy   User      @relation(fields: [requestedById], references: [id])
  resolvedAt    DateTime?

  @@index([dealId])
}

model DeliveryLine {
  id         String   @id @default(cuid())
  deliveryId String
  delivery   Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  dealItemId String
  dealItem   DealItem @relation(fields: [dealItemId], references: [id], onDelete: Cascade)
  qty        Int
  serials    String?
}

// Quotes and invoices share one 9-digit sequence.
model DocSequence {
  id   String @id
  next Int
}

model Invoice {
  id            String    @id @default(cuid())
  number        String    @unique
  dealId        String
  deal          Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  deliveryId    String?   @unique
  delivery      Delivery? @relation(fields: [deliveryId], references: [id], onDelete: SetNull)
  accountId     String
  account       Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  issuedAt      DateTime
  dueAt         DateTime
  amount        Decimal   @db.Decimal(14, 2)
  // Esagra of this invoice at the moment it was issued (basis for the sale half of the commission).
  esagraAtIssue Decimal   @db.Decimal(14, 2)
  issuedById    String
  issuedBy      User      @relation(fields: [issuedById], references: [id])
  createdAt     DateTime  @default(now())

  applications      PaymentApplication[]
  promises          PaymentPromise[]
  steps             InvoiceStep[]
  // Collection next movement (§60): at most one visible next move, or a wait with control.
  collectNext       String?
  collectNextAt     DateTime?
  collectWaitingFor String?
  collectContact    String?
  collectByName     String?
  collectAt         DateTime?
  commissions       CommissionEntry[]
  quoteId           String?
  quote             Quote?               @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  docLang           Lang                 @default(EN)
  // Partial invoice (covers only part of the ordered quantities).
  partial           Boolean              @default(false)
  // Controlled bridge to the accounting system: SOLU's invoice is the business object;
  // the accounting ID is recorded only when the accounting system confirms it.
  externalSystem    String?
  externalId        String?
  syncState         AccountingSync       @default(NOT_SENT)
  syncAt            DateTime?
  syncNote          String?
  // Why the customer paid less (withholding, deduction, bank fee). The balance stays open until resolved.
  shortPayNote      String?
  // C-19: the legal invoice was issued outside SOLU (DIAN electronic invoice). `number` is that invoice's number;
  // `amount` stays the USD value before IVA used for Eságara and collection; docTotal is the legal total as issued.
  external          Boolean              @default(false)
  docCurrency       String?
  docTotal          Decimal?             @db.Decimal(16, 2)

  @@index([accountId])
  @@index([dueAt])
}

enum AccountingSync {
  NOT_SENT
  SENT
  CONFIRMED
  UNCERTAIN
}

model CustomerPayment {
  id              String    @id @default(cuid())
  accountId       String
  account         Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  amount          Decimal   @db.Decimal(14, 2)
  receivedAt      DateTime
  reference       String?
  reconciledAt    DateTime?
  reconciledById  String?
  reconciledBy    User?     @relation("CashReconciler", fields: [reconciledById], references: [id])
  createdById     String
  createdBy       User      @relation("CashRecorder", fields: [createdById], references: [id])
  createdAt       DateTime  @default(now())
  // What to do with cash left over after allocation (credit on account, refund, ask the customer).
  residualNote    String?
  /// CASH (money in the bank) | WITHHOLDING (kept by the customer for the tax authority: settles the invoice, never cash)
  kind            String    @default("CASH")
  /// RETEFUENTE | RETEICA | RETEIVA | OTHER
  withholdingType String?
  certificate     String?
  withholdingNote String?

  applications PaymentApplication[]
  bankMatches  BankMatch[]

  @@index([accountId])
}

model PaymentApplication {
  id        String          @id @default(cuid())
  paymentId String
  payment   CustomerPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceId String
  invoice   Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount    Decimal         @db.Decimal(14, 2)

  @@index([invoiceId])
}

model PaymentPromise {
  id             String          @id @default(cuid())
  invoiceId      String
  invoice        Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  promisedFor    DateTime
  promisedBy     String
  source         String
  recordedById   String
  recordedBy     User            @relation(fields: [recordedById], references: [id])
  createdAt      DateTime        @default(now())
  // Comercial C3 (§61): amount and role; a new promise replaces the open one, never overwrites it.
  amount         Decimal?        @db.Decimal(14, 2)
  promisedByRole String?
  replacedById   String?         @unique
  replacedBy     PaymentPromise? @relation("PromiseReplaced", fields: [replacedById], references: [id], onDelete: SetNull)
  replaces       PaymentPromise? @relation("PromiseReplaced")
  replacedAt     DateTime?

  @@index([invoiceId])
}

// ---------- Commissions ----------

model CommissionPolicy {
  id                     String   @id @default(cuid())
  version                Int      @unique
  effectiveFrom          DateTime
  // [{ "min": 0, "rate": 0 }, { "min": 12, "rate": 8 }, { "min": 18, "rate": 10 }]  (percent)
  tiers                  Json
  newClientBonus         Decimal  @default(2) @db.Decimal(5, 2)
  salePercent            Int      @default(50)
  lossDays               Int      @default(90)
  /// Módulo 12: share of the commission fund for each function (they add up to 100)
  commercialPct          Int      @default(100)
  operationalPct         Int      @default(0)
  /// true = the collection half is released in proportion to reconciled collection and is never lost for lateness
  proportionalCollection Boolean  @default(false)
  approvedBy             String
  notes                  String?
  createdAt              DateTime @default(now())
}

// Snapshot written when management approves a half; paid when payroll confirms it.
model CommissionEntry {
  id           String         @id @default(cuid())
  invoiceId    String
  invoice      Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  half         CommissionHalf
  userId       String
  user         User           @relation("CommissionOwner", fields: [userId], references: [id])
  amount       Decimal        @db.Decimal(14, 2)
  calculation  String
  approvedById String
  approvedBy   User           @relation("CommissionApprover", fields: [approvedById], references: [id])
  approvedAt   DateTime       @default(now())
  paidAt       DateTime?
  payrollRef   String?

  /// Módulo 12 R3: the collection half is paid in parts as the customer pays; each part is its own entry (0, 1, 2…).
  seq   Int                      @default(0)
  /// the settlement run that approved this entry (null for entries approved before runs existed)
  run   CommissionSettlementRun? @relation(fields: [runId], references: [id])
  runId String?                  @map("commissionSettlementRunId")

  // Módulo 12: one sale can pay several people, and the collection half in several parts.
  @@unique([invoiceId, half, userId, seq])
  @@index([userId])
}

// ---------- Communication Intelligence ----------
// Only conversations with known customers (or messages someone registers by hand).
// SOLU separates what the customer said (FACT) from what it infers (INFERENCE); a person confirms.

enum CommChannel {
  WHATSAPP
  EMAIL
  CALL
  NOTE
}

enum CommDirection {
  IN
  OUT
}

model CommThread {
  id          String      @id @default(cuid())
  channel     CommChannel
  subject     String?
  externalKey String?     @unique
  partyName   String?
  partyAddr   String?
  accountId   String?
  account     Account?    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contactId   String?
  contact     Contact?    @relation(fields: [contactId], references: [id], onDelete: SetNull)
  dealId      String?
  deal        Deal?       @relation(fields: [dealId], references: [id], onDelete: SetNull)
  lastAt      DateTime
  lastInAt    DateTime?
  lastOutAt   DateTime?
  closedAt    DateTime?
  createdAt   DateTime    @default(now())

  messages CommMessage[]
  items    CommItem[]

  @@index([lastAt])
  @@index([accountId])
}

model CommMessage {
  id          String        @id @default(cuid())
  threadId    String
  thread      CommThread    @relation(fields: [threadId], references: [id], onDelete: Cascade)
  direction   CommDirection
  authorName  String
  body        String
  sentAt      DateTime
  externalId  String?       @unique
  createdById String?
  createdBy   User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())

  attachments CommAttachment[]

  @@index([threadId, sentAt])
}

model CommAttachment {
  id        String      @id @default(cuid())
  messageId String
  message   CommMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  name      String
  mime      String
  size      Int
  data      Bytes
  createdAt DateTime    @default(now())
}

model CommItem {
  id          String     @id @default(cuid())
  threadId    String
  thread      CommThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  field       String
  value       String
  basis       String
  evidence    String
  reasoning   String?
  status      String     @default("PROPOSED")
  decidedById String?
  decidedBy   User?      @relation(fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt   DateTime?
  createdAt   DateTime   @default(now())

  @@index([threadId])
}

// ---------- Quotes ----------
// A Quote is the solution that protects a customer result. Drafts are internal; presenting
// freezes the version and protects its economics. Any later change is "Rev. N" with the same number.

enum QuoteStatus {
  DRAFT
  PRESENTED
  SUPERSEDED
  ACCEPTED
  DECLINED
}

model Quote {
  id          String      @id @default(cuid())
  dealId      String
  deal        Deal        @relation(fields: [dealId], references: [id], onDelete: Cascade)
  number      String
  rev         Int         @default(0)
  status      QuoteStatus @default(DRAFT)
  lang        Lang        @default(EN)
  createdById String
  createdBy   User        @relation(fields: [createdById], references: [id])
  createdAt   DateTime    @default(now())
  issuedAt    DateTime?
  presentedAt DateTime?
  decidedAt   DateTime?

  // The solution
  solution           String?
  supplyPrimary      String?
  supplyAlt          String?
  promiseText        String?
  promiseCondition   String?
  // Landed cost (current version), each component with its source
  costCurrency       String    @default("USD")
  fxRate             Decimal?  @db.Decimal(14, 6)
  fxSource           String?
  supplierCost       Decimal   @default(0) @db.Decimal(14, 2)
  supplierSrc        String?
  freightCost        Decimal   @default(0) @db.Decimal(14, 2)
  freightSrc         String?
  otherCosts         Decimal   @default(0) @db.Decimal(14, 2)
  otherSrc           String?
  /// C5 §15: CONFIRMED | QUOTED | HISTORICAL | ESTIMATED | PENDING per cost bucket (null = derived)
  supplierStatus     String?
  freightStatus      String?
  otherStatus        String?
  changeNote         String?
  // Protected economics: fixed when presented, never changed afterwards
  protSale           Decimal?  @db.Decimal(14, 2)
  protCost           Decimal?  @db.Decimal(14, 2)
  protEsagra         Decimal?  @db.Decimal(14, 2)
  protPolicy         Int?
  // Terms printed on the document
  billTo             String?
  shipTo             String?
  leadMinDays        Int?
  leadMaxDays        Int?
  incoterm           String?
  paymentTerms       String?
  validityDays       Int       @default(30)
  condition          String    @default("New & original")
  // Seller, currency and tax of the document (C-19 to C-21). Internal economics stay in USD before IVA.
  /// USD | COP: the currency the customer sees. Lines are kept in USD; a COP document converts them at docFxRate.
  currency           String    @default("USD")
  /// COP per USD fixed for this document, and where it came from (official TRM of a date, or typed with a reason).
  docFxRate          Decimal?  @db.Decimal(12, 2)
  docFxSource        String?
  ivaExempt          Boolean   @default(false)
  ivaExemptReason    String?
  /// Frozen when presented: the IVA % applied and the selling company as it was that day.
  ivaPct             Decimal?  @db.Decimal(5, 2)
  sellerSnap         Json?
  // Customer decision future
  supplierValidUntil DateTime?
  supplyConfirmed    Boolean   @default(false)
  decisionAt         DateTime?
  decisionLabel      String?
  decisionPath       String?
  decisionEvidence   String?
  promiseDecideBy    DateTime?

  lines             QuoteLine[]
  scenarios         QuoteScenario[]
  invoices          Invoice[]
  customerPos       CustomerPO[]
  esagaraExceptions EsagaraException[]
  presentations     PresentationRecord[]

  @@unique([number, rev])
  @@index([dealId])
}

model QuoteLine {
  id          String  @id @default(cuid())
  quoteId     String
  quote       Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  position    Int     @default(0)
  qty         Int
  code        String?
  description String
  unitPrice   Decimal @db.Decimal(14, 2)
}

model QuoteScenario {
  id          String  @id @default(cuid())
  quoteId     String
  quote       Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  position    Int     @default(0)
  label       String
  price       Decimal @db.Decimal(14, 2)
  cost        Decimal @db.Decimal(14, 2)
  leadMinDays Int
  leadMaxDays Int
  risk        String
  promise     String
  recommended Boolean @default(false)
  why         String?
}

// ---------- Customer PO received ----------
// A PO is compared with the quote it answers before anything is promised.
// Accepting it is a Command (PoAcceptance, immutable, with its preconditions and effects), never a status edit.

enum ResolutionOption {
  AMEND_DATE
  EXPEDITE_ABSORB
  EXPEDITE_CHARGE
}

enum ResolutionState {
  REQUESTED
  CONFIRMED
  WITHDRAWN
}

model CustomerPO {
  id                  String    @id @default(cuid())
  dealId              String
  deal                Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  quoteId             String?
  quote               Quote?    @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  number              String
  receivedAt          DateTime
  requiredBy          DateTime?
  incoterm            String?
  paymentTerms        String?
  shipTo              String?
  currency            String    @default("USD")
  quoteRef            String?
  source              String?
  createdById         String
  createdByName       String
  createdAt           DateTime  @default(now())
  rejectedAt          DateTime?
  rejectedByName      String?
  rejectReason        String?
  // Comercial C6 §22: what the PO says about who buys, tax and conditions (compared, never assumed).
  legalEntity         String?
  taxIdOnPo           String?
  billTo              String?
  /// INCLUDED (price includes IVA) | ADDED (IVA on top) | EXEMPT | NOT_STATED
  ivaMode             String?
  /// When the PO is in pesos: the quote's fixed rate used to compare it (`currency` says COP).
  docFxRate           Decimal?  @db.Decimal(12, 2)
  warranty            String?
  documents           String?
  penalties           String?
  otherConditions     String?
  /// {key: {by, at, note}}: new conditions reviewed and accepted with a note (never silently)
  conditionsAck       Json?
  // C6 §23 / C-12: stock and price confirmed again with the supplier before accepting
  supplyRevalidatedAt DateTime?
  supplyRevalidation  String?
  supplyRevalidatedBy String?

  lines       CustomerPOLine[]
  resolutions PoResolution[]
  acceptance  PoAcceptance?
  allocations PoAllocation[]
  dispatches  DispatchInstruction[]

  @@index([dealId])
}

model CustomerPOLine {
  id           String     @id @default(cuid())
  poId         String
  po           CustomerPO @relation(fields: [poId], references: [id], onDelete: Cascade)
  position     Int        @default(0)
  qty          Int
  code         String?
  description  String
  unitPrice    Decimal    @db.Decimal(14, 2)
  /// Unit price as written on the PO when it came in pesos (unitPrice is its USD value at the quote's rate).
  docUnitPrice Decimal?   @db.Decimal(16, 2)
}

model PoResolution {
  id              String           @id @default(cuid())
  poId            String
  po              CustomerPO       @relation(fields: [poId], references: [id], onDelete: Cascade)
  field           String
  option          ResolutionOption
  state           ResolutionState  @default(REQUESTED)
  promiseDate     DateTime
  costDelta       Decimal          @default(0) @db.Decimal(14, 2)
  priceDelta      Decimal          @default(0) @db.Decimal(14, 2)
  scenarioLabel   String?
  message         String?
  evidence        String?
  chosenById      String
  chosenByName    String
  chosenAt        DateTime         @default(now())
  confirmedByName String?
  confirmedAt     DateTime?

  @@index([poId])
}

model PoAcceptance {
  id             String     @id @default(cuid())
  poId           String     @unique
  po             CustomerPO @relation(fields: [poId], references: [id], onDelete: Cascade)
  acceptedById   String
  acceptedByName String
  acceptedAt     DateTime   @default(now())
  promiseDate    DateTime
  resolutionId   String?
  // What was true when the command ran: comparison, preconditions and effects.
  snapshot       Json
}

model SupplierPOLine {
  id           String     @id @default(cuid())
  supplierPoId String
  supplierPo   SupplierPO @relation(fields: [supplierPoId], references: [id], onDelete: Cascade)
  position     Int        @default(0)
  qty          Int
  code         String?
  description  String
  unitCost     Decimal    @db.Decimal(14, 2)
}

// What must be paid and when (a milestone of the supplier's terms). It is not a request and not a payment.
model PaymentRequirement {
  id           String     @id @default(cuid())
  supplierPoId String
  supplierPo   SupplierPO @relation(fields: [supplierPoId], references: [id], onDelete: Cascade)
  position     Int        @default(0)
  label        String
  percent      Int
  amount       Decimal    @db.Decimal(14, 2)
  trigger      String
  dueBy        DateTime?

  payments SupplierPayment[]
}

enum ExecutionState {
  SENT
  UNCERTAIN
  CONFIRMED
  FAILED
}

// An attempt to move the money outside SOLU (bank portal). Only CONFIRMED means paid.
model PaymentExecution {
  id             String          @id @default(cuid())
  paymentId      String
  payment        SupplierPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  amount         Decimal         @db.Decimal(14, 2)
  sentAt         DateTime
  bankRef        String?
  state          ExecutionState  @default(SENT)
  note           String?
  recordedById   String
  recordedByName String
  resolvedAt     DateTime?
  resolvedByName String?
  evidence       String?
  // O4 §21: how it was paid and what it really cost.
  method         String?
  feeUsd         Decimal?        @db.Decimal(14, 2)
  fxRate         Decimal?        @db.Decimal(14, 6)
  createdAt      DateTime        @default(now())
  bankMatches    BankMatch[]

  @@index([paymentId])
}

// ---------- Logistics Forward View ----------
// A Shipment is its own object: physical movement with the carrier's truth (ETA, scans),
// kept apart from SOLU's expected delivery and from the customer promise (on the Deal).
enum ShipmentMode {
  AIR
  COURIER
  OCEAN
  GROUND
}

enum CustomsState {
  NOT_REQUIRED
  PENDING
  HOLD
  CLEARED
}

enum ReceiptState {
  PENDING
  CONFIRMED
  DISPUTED
}

enum ShipEventKind {
  SCAN
  ETA_CHANGE
  EXCEPTION
  CUSTOMS
  DELIVERED
  NOTE
}

model Shipment {
  id                     String       @id @default(cuid())
  code                   String       @unique
  dealId                 String
  deal                   Deal         @relation(fields: [dealId], references: [id], onDelete: Cascade)
  supplierPoId           String?
  supplierPo             SupplierPO?  @relation(fields: [supplierPoId], references: [id], onDelete: SetNull)
  carrierName            String
  tracking               String?
  mode                   ShipmentMode @default(AIR)
  origin                 String?
  destination            String?
  destLat                Float?
  destLng                Float?
  international          Boolean      @default(true)
  // true = the carrier hands it to the customer; false = it arrives to us/our broker first
  toCustomer             Boolean      @default(false)
  // Baseline (what we planned when it was recorded) vs actual
  plannedRts             DateTime?
  rtsAt                  DateTime?
  plannedPickup          DateTime?
  pickedUpAt             DateTime?
  plannedDelivery        DateTime?
  carrierEta             DateTime?
  carrierEtaAt           DateTime?
  carrierEtaSource       String?
  // O5a §30: the dates that were missing from the set (each is its own fact, never one "ETA").
  plannedDeparture       DateTime?
  departedAt             DateTime?
  customsExpectedRelease DateTime?
  deliveredAt            DateTime?
  deliveredNote          String?
  customs                CustomsState @default(NOT_REQUIRED)
  customsNote            String?
  docs                   Json?
  receipt                ReceiptState @default(PENDING)
  receivedAt             DateTime?
  receivedByName         String?
  receiptNote            String?
  disputedAt             DateTime?
  disputeNote            String?
  deliveryId             String?      @unique
  delivery               Delivery?    @relation(fields: [deliveryId], references: [id], onDelete: SetNull)
  createdByName          String
  createdAt              DateTime     @default(now())

  lines           ShipmentLine[]
  events          ShipmentEvent[]
  decisions       ShipmentDecision[]
  carrierInvoices CarrierInvoice[]
  customsCase     CustomsCase?

  @@index([dealId])
}

model ShipmentLine {
  id          String   @id @default(cuid())
  shipmentId  String
  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  dealItemId  String?
  qty         Int
  description String
}

model ShipmentEvent {
  id             String        @id @default(cuid())
  shipmentId     String
  shipment       Shipment      @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  at             DateTime
  kind           ShipEventKind @default(SCAN)
  location       String?
  lat            Float?
  lng            Float?
  text           String
  // Material = changes the outcome or needs a person. Normal scans are summarised, never notified.
  material       Boolean       @default(false)
  etaBefore      DateTime?
  etaAfter       DateTime?
  source         String?
  recordedByName String?

  @@index([shipmentId, at])
}

model ShipmentDecision {
  id            String    @id @default(cuid())
  shipmentId    String
  shipment      Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  option        String
  title         String
  note          String?
  newExpected   DateTime?
  decidedByName String
  decidedAt     DateTime  @default(now())
}

// E2: every email SOLU sends from sales@, so replies can be matched (read-only, Mail.Read).
// Reply facts are per template and per supplier only: no sender/user field on purpose
// (no per-person metrics). The text of the reply is not stored, only a short preview.
model OutboundMail {
  id             String    @id @default(cuid())
  template       String // RFQ | FOLLOWUP | NEGOTIATE | DELIVERY | OFFER | PAYMENT
  refKind        String // RFQR | OFFER | SPO | QUOTE | INVOICE
  refId          String
  refCode        String?
  partyKind      String // SUPPLIER | CUSTOMER
  supplierId     String?
  supplier       Supplier? @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  accountId      String?
  account        Account?  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  dealId         String?
  toAddr         String
  subject        String
  sentAt         DateTime  @default(now())
  /// E-safety: SENDING → SENT | FAILED | UNCERTAIN (network cut mid-send: reconciled against Sent Items before any retry).
  status         String    @default("SENT")
  /// One key per compose screen / RFQ form: a double click or a resubmit never sends twice.
  idemKey        String?   @unique
  error          String?
  conversationId String?
  repliedAt      DateTime?
  replyFrom      String?
  replySubject   String?
  replyPreview   String?
  autoReplyAt    DateTime?
  bouncedAt      DateTime?

  @@index([conversationId])
  @@index([supplierId])
  @@index([template])
  @@index([refKind, refId])
  @@index([sentAt])
  @@index([status])
}

/// #4 Audit trail (constitution No Debt Zone): every material change — money, bank data, authority,
/// states and document versions — with who, when, before and after. Written automatically by db.ts.
/// Rows are never edited or deleted by the app.
model AuditEvent {
  id        String   @id @default(cuid())
  at        DateTime @default(now())
  actorId   String?
  actorName String
  model     String
  entityId  String
  action    String // CREATE | UPDATE | DELETE
  changes   Json // { field: [before, after] }; bank account numbers are stored masked

  @@index([model, entityId])
  @@index([at])
}

// ===================== MERCADO (Módulo 09 · Mercadeo Exploratorio) =====================
// Provenance on every material fact: sourceType · sourceRef · observedAt · confidence · capturedBy.
// confidence: VERIFIED | REPORTED | INFERRED | UNKNOWN. INFERRED never becomes VERIFIED without new evidence.

/// A deliberate investigation with a purpose. Not a lead and not a Journey.
model Exploration {
  id                  String    @id @default(cuid())
  name                String
  purpose             String
  hypothesis          String?
  /// TERRITORY | INDUSTRY | COMPANY | PLANT | TECHNOLOGY | APPLICATION
  scope               String    @default("INDUSTRY")
  scopeText           String?
  ownerId             String
  owner               User      @relation("ExplorationOwner", fields: [ownerId], references: [id])
  startedAt           DateTime  @default(now())
  nextReviewAt        DateTime?
  /// MOVE | WAIT | TRIGGER | CLARITY_NEEDED (always one of them)
  movement            String    @default("CLARITY_NEEDED")
  nextMove            String?
  nextMoveAt          DateTime?
  waitingFor          String?
  waitingUntil        DateTime?
  triggerOn           DateTime?
  triggerEvent        String?
  /// ACTIVE | DORMANT | CLOSED
  lifecycle           String    @default("ACTIVE")
  resultSummary       String?
  closedAt            DateTime?
  createdFromSignalId String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  links       ExplorationLink[]
  signals     MarketSignal[]
  gaps        KnowledgeGap[]
  whiteSpaces WhiteSpace[]
  futures     FutureOpportunity[]
  tasks       Task[]
  deals       Deal[]

  @@index([lifecycle, movement])
}

/// What an exploration is about: companies, plants, suppliers, brands, product codes.
model ExplorationLink {
  id            String      @id @default(cuid())
  explorationId String
  exploration   Exploration @relation(fields: [explorationId], references: [id], onDelete: Cascade)
  /// ACCOUNT | PLANT | SUPPLIER | CONTACT | BRAND | PART_CODE
  kind          String
  refId         String
  label         String
  why           String?
  createdAt     DateTime    @default(now())

  @@unique([explorationId, kind, refId])
}

/// An observed change that deserves understanding. Signal ≠ Need ≠ Opportunity.
model MarketSignal {
  id             String       @id @default(cuid())
  /// EXPANSION | NEW_PLANT | INVESTMENT | ACQUISITION | NEW_TECHNOLOGY | DISCONTINUATION | REGULATORY | ECONOMIC | SHUTDOWN | ROLE_CHANGE | OTHER
  kind           String
  what           String
  whyMatters     String?
  accountId      String?
  account        Account?     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  plantId        String?
  plant          Plant?       @relation(fields: [plantId], references: [id], onDelete: SetNull)
  explorationId  String?
  exploration    Exploration? @relation(fields: [explorationId], references: [id], onDelete: SetNull)
  /// NEW | EXPLORING | DISMISSED
  status         String       @default("NEW")
  dismissedNote  String?
  sourceType     String
  sourceRef      String?
  observedAt     DateTime
  confidence     String       @default("REPORTED")
  capturedById   String?
  capturedByName String
  createdAt      DateTime     @default(now())

  @@index([status])
}

/// Something worth learning that we don't know yet. Can become a Next Movement.
model KnowledgeGap {
  id             String       @id @default(cuid())
  question       String
  why            String?
  explorationId  String?
  exploration    Exploration? @relation(fields: [explorationId], references: [id], onDelete: Cascade)
  accountId      String?
  account        Account?     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  plantId        String?
  plant          Plant?       @relation(fields: [plantId], references: [id], onDelete: Cascade)
  /// OPEN | RESOLVED
  status         String       @default("OPEN")
  answer         String?
  answerSource   String?
  resolvedAt     DateTime?
  resolvedByName String?
  createdByName  String
  createdAt      DateTime     @default(now())

  @@index([status])
}

/// A part of a company or market we haven't explored or served yet.
model WhiteSpace {
  id            String       @id @default(cuid())
  /// PLANT | AREA | COUNTRY | TECHNOLOGY | PERSON | APPLICATION | GROUP_COMPANY | CATEGORY
  kind          String
  what          String
  why           String?
  accountId     String?
  account       Account?     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  explorationId String?
  exploration   Exploration? @relation(fields: [explorationId], references: [id], onDelete: Cascade)
  /// OPEN | EXPLORING | RESOLVED | NOT_RELEVANT
  status        String       @default("OPEN")
  note          String?
  createdByName String
  createdAt     DateTime     @default(now())
  resolvedAt    DateTime?

  @@index([status])
}

/// An operating site of a company (not just an address).
model Plant {
  id             String   @id @default(cuid())
  accountId      String
  account        Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name           String
  city           String?
  country        String?
  operationType  String?
  notes          String?
  sourceType     String
  sourceRef      String?
  observedAt     DateTime
  confidence     String   @default("REPORTED")
  capturedByName String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  signals     MarketSignal[]
  gaps        KnowledgeGap[]
  futures     FutureOpportunity[]
  assets      InstalledAsset[]
  impacts     ImpactProfile[]
  insights    AccountInsight[]
  employments Employment[]
  deals       Deal[]

  @@index([accountId])
}

/// Other names the same organization goes by (Mercado §4.3): legal name, trade name, acronym.
model AccountAlias {
  id            String   @id @default(cuid())
  accountId     String
  account       Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name          String
  kind          String   @default("TRADE") // LEGAL | TRADE | ACRONYM
  createdByName String
  createdAt     DateTime @default(now())

  @@unique([accountId, name])
}

/// "How this account works" (Mercado §7, §4.16–4.18): one observation with its evidence.
/// block = OPERATE | DECIDE | BUY | VALUE | HURT. DECIDE rows form the Decision Map (area + step + condition).
/// Observations are never overwritten: a replaced one keeps supersededAt and the reason.
model AccountInsight {
  id             String    @id @default(cuid())
  accountId      String
  account        Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  plantId        String?
  plant          Plant?    @relation(fields: [plantId], references: [id], onDelete: Cascade)
  block          String
  topic          String?
  area           String?
  step           String?
  condition      String?
  statement      String
  evidence       String?
  sourceType     String
  sourceRef      String?
  observedAt     DateTime
  confidence     String    @default("REPORTED")
  capturedByName String
  supersededAt   DateTime?
  supersededNote String?
  createdAt      DateTime  @default(now())

  @@index([accountId, block])
}

/// Installed equipment observed at a plant (Mercado §4.8). Plant → process → line → asset.
model InstalledAsset {
  id              String   @id @default(cuid())
  plantId         String
  plant           Plant    @relation(fields: [plantId], references: [id], onDelete: Cascade)
  process         String?
  line            String?
  name            String
  manufacturer    String?
  model           String?
  serial          String?
  operationalRole String?
  redundancy      String   @default("UNKNOWN") // NONE | PARTIAL | FULL | UNKNOWN
  critical        Boolean  @default(false)
  criticalWhy     String?
  knownComponents String?
  sourceType      String
  sourceRef       String?
  observedAt      DateTime
  confidence      String   @default("REPORTED")
  capturedByName  String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  impacts ImpactProfile[]

  @@index([plantId])
}

/// What a stop costs (Mercado §4.19, §8): always a range with its basis, never false precision.
/// level REPORTED = the customer's own figure; GUIDED = SOLU computed it from the inputs below.
model ImpactProfile {
  id               String          @id @default(cuid())
  plantId          String
  plant            Plant           @relation(fields: [plantId], references: [id], onDelete: Cascade)
  assetId          String?
  asset            InstalledAsset? @relation(fields: [assetId], references: [id], onDelete: SetNull)
  scope            String
  stopsLine        String          @default("UNKNOWN") // YES | PARTIAL | NO | UNKNOWN
  timeToImpact     String?
  level            String          @default("REPORTED")
  currency         String          @default("COP")
  costPerHourMin   Decimal?        @db.Decimal(16, 2)
  costPerHourMax   Decimal?        @db.Decimal(16, 2)
  unitsPerHour     Decimal?        @db.Decimal(14, 2)
  contributionUnit Decimal?        @db.Decimal(16, 2)
  scrapPerHour     Decimal?        @db.Decimal(16, 2)
  idleLaborPerHour Decimal?        @db.Decimal(16, 2)
  restartCost      Decimal?        @db.Decimal(16, 2)
  basis            String?
  sourceType       String
  sourceRef        String?
  observedAt       DateTime
  confidence       String          @default("REPORTED")
  capturedByName   String
  createdAt        DateTime        @default(now())

  @@index([plantId])
}

/// A person's job at a company (Mercado §4.10): person (Contact) ≠ employment. Dates, plant, area, real role.
/// No psychological profiles or personal data without a business reason.
model Employment {
  id             String    @id @default(cuid())
  contactId      String
  contact        Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  accountId      String
  account        Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  plantId        String?
  plant          Plant?    @relation(fields: [plantId], references: [id], onDelete: SetNull)
  area           String?
  role           String?
  startedOn      DateTime?
  endedOn        DateTime?
  sourceType     String
  sourceRef      String?
  confidence     String    @default("REPORTED")
  capturedByName String
  createdAt      DateTime  @default(now())

  @@index([accountId])
  @@index([contactId])
}

/// Future that is not a Need or a quote yet (Mercado v2.2 §41). No invented probabilities.
model FutureOpportunity {
  id             String       @id @default(cuid())
  /// CAPEX | SHUTDOWN | NEW_PLANT | RETROFIT | TECH_CHANGE | REGULATORY | STRATEGIC
  kind           String
  description    String
  accountId      String?
  account        Account?     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  plantId        String?
  plant          Plant?       @relation(fields: [plantId], references: [id], onDelete: SetNull)
  process        String?
  explorationId  String?
  exploration    Exploration? @relation(fields: [explorationId], references: [id], onDelete: SetNull)
  /// When it is expected to happen (drives the 0–30 / 31–90 / 91–365 / >365 day horizon).
  expectedAt     DateTime?
  triggerOn      DateTime?
  triggerEvent   String?
  ownerId        String?
  owner          User?        @relation("FutureOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  impact         String?
  valueBasis     String?
  gaps           String?
  nextMove       String?
  nextMoveAt     DateTime?
  /// OPEN | CONVERTED | CLOSED
  status         String       @default("OPEN")
  closedNote     String?
  dealId         String?
  sourceType     String
  sourceRef      String?
  observedAt     DateTime
  confidence     String       @default("REPORTED")
  capturedByName String
  createdAt      DateTime     @default(now())

  @@index([status, expectedAt])
}

/// Mercado M3 · where economic data comes from (§9.1). The column mapping is reusable per source.
model IntelligenceSource {
  id            String              @id @default(cuid())
  name          String              @unique
  kind          String              @default("OTHER") // SUPERSOCIEDADES | CAMARA | SECTOR | PROVIDED | INTERNAL | OTHER
  description   String?
  mapping       Json?
  createdByName String
  createdAt     DateTime            @default(now())
  imports       DatasetImport[]
  snapshots     FinancialSnapshot[]
}

/// One uploaded file (§9.2, §23). The original file is kept as evidence; rows are staged before any canonical write.
/// status: PARSED | MAPPING_REQUIRED | REVIEW_REQUIRED | READY_TO_COMMIT | COMMITTED | FAILED | DISCARDED
model DatasetImport {
  id              String              @id @default(cuid())
  sourceId        String
  source          IntelligenceSource  @relation(fields: [sourceId], references: [id])
  fileName        String
  mime            String
  size            Int
  hash            String              @unique
  data            Bytes
  status          String              @default("PARSED")
  headers         Json
  preview         Json
  rowCount        Int                 @default(0)
  mapping         Json?
  scale           String?
  currency        String?
  decimalStyle    String?
  fixedYear       Int?
  /// Most recent fiscal year the file reports (its publication). For the same year, the newest publication wins.
  reportYear      Int?
  okCount         Int                 @default(0)
  errorCount      Int                 @default(0)
  reviewCount     Int                 @default(0)
  failure         String?
  createdByName   String
  createdAt       DateTime            @default(now())
  committedAt     DateTime?
  committedByName String?
  rows            DatasetRow[]
  snapshots       FinancialSnapshot[]
}

/// Staging row. status OK | ERROR | REVIEW | SKIPPED; decision INCLUDE | EXCLUDE for REVIEW rows.
model DatasetRow {
  id       String        @id @default(cuid())
  importId String
  import   DatasetImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  rowNo    Int
  nit      String?
  year     Int?
  name     String?
  parsed   Json?
  status   String
  messages String[]
  decision String?

  @@index([importId, status])
  @@index([importId, nit, year])
}

/// A company as seen in economic datasets, keyed by NIT (first 9 digits). Linked to a customer/prospect by NIT.
model MarketCompany {
  id         String              @id @default(cuid())
  nit        String              @unique
  name       String
  otherNames String[]
  ciiu       String?
  sector     String?
  department String?
  city       String?
  accountId  String?             @unique
  account    Account?            @relation(fields: [accountId], references: [id], onDelete: SetNull)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  snapshots  FinancialSnapshot[]

  @@index([name])
}

/// Immutable yearly figures from one import (§9.4). Amounts in currency units (scale already applied).
/// A later file for the same year is another version, never an overwrite.
model FinancialSnapshot {
  id                 String             @id @default(cuid())
  companyId          String
  company            MarketCompany      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fiscalYear         Int
  sourceId           String
  source             IntelligenceSource @relation(fields: [sourceId], references: [id])
  importId           String
  import             DatasetImport      @relation(fields: [importId], references: [id])
  currency           String
  unitsScale         String
  revenue            Decimal?           @db.Decimal(22, 2)
  operatingIncome    Decimal?           @db.Decimal(22, 2)
  netIncome          Decimal?           @db.Decimal(22, 2)
  assets             Decimal?           @db.Decimal(22, 2)
  liabilities        Decimal?           @db.Decimal(22, 2)
  equity             Decimal?           @db.Decimal(22, 2)
  currentAssets      Decimal?           @db.Decimal(22, 2)
  currentLiabilities Decimal?           @db.Decimal(22, 2)
  debt               Decimal?           @db.Decimal(22, 2)
  employees          Int?
  createdAt          DateTime           @default(now())

  @@unique([companyId, fiscalYear, importId])
  @@index([fiscalYear])
}

/// Versioned settings decided by management (e.g. thresholds for economic signals, decision log §32).
model MarketSetting {
  id            String   @id @default(cuid())
  key           String
  version       Int
  value         Json
  updatedByName String
  createdAt     DateTime @default(now())

  @@unique([key, version])
}

/// Mercado M4 (§4.21, §10): how a customer actually pays, recomputed when cash is reconciled.
/// A new row only when the figures change, so the history of rows is the trend over time. Derived data: not audited.
model PaymentBehaviorSnapshot {
  id           String   @id @default(cuid())
  accountId    String
  account      Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  formula      String
  rulesVersion Int
  reason       String
  expectedDays Int?
  avgDelay     Float?
  onTimePct    Float?
  trend        String
  collected    Int
  openTotal    Decimal  @db.Decimal(14, 2)
  metrics      Json
  createdAt    DateTime @default(now())

  @@index([accountId, createdAt])
}

/// Mercado M5 (§11.4): what we remember about a person, only business-relevant things they said or showed.
/// Never psychological profiles or personal labels (§11.5); comm-policy.ts refuses them on save.
/// kind: DECISION_ROLE | VALUES | OBJECTIVE | PROBLEM | TOPIC | PREFERENCE
model PersonNote {
  id             String    @id @default(cuid())
  contactId      String
  contact        Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  kind           String
  statement      String
  evidence       String?
  sourceType     String
  sourceRef      String?
  observedAt     DateTime
  confidence     String    @default("REPORTED")
  capturedByName String
  supersededAt   DateTime?
  createdAt      DateTime  @default(now())

  @@index([contactId])
}

/// Mercado M5 (§11.4, §11.6): a commitment still open — ours (OURS) or theirs (THEIRS).
/// status: OPEN | DONE | DROPPED. Tasks, Journey waits, payment promises and recoveries are read as loops too, not copied here.
model OpenLoop {
  id             String    @id @default(cuid())
  side           String
  what           String
  dueAt          DateTime?
  accountId      String?
  account        Account?  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contactId      String?
  contact        Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  dealId         String?
  explorationId  String?
  status         String    @default("OPEN")
  closedAt       DateTime?
  closedNote     String?
  closedByName   String?
  sourceType     String
  sourceRef      String?
  observedAt     DateTime
  capturedByName String
  createdAt      DateTime  @default(now())

  @@index([accountId, status])
  @@index([contactId, status])
}

/// Mercado M5 (§11.12): a message prepared through the communication policy, with what it was built from.
/// SOLU never sends it: a person reviews, edits and sends it, then records it here (human-review gate).
/// status: DRAFT | SENT | DISCARDED
model PreparedMessage {
  id                  String    @id @default(cuid())
  purpose             String
  audienceRole        String?
  channel             String
  contactId           String?
  contact             Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  accountId           String?
  account             Account?  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  draft               String
  finalText           String?
  sourceContextIds    String[]
  factsUsed           Json
  inferencesUsed      Json
  tonePolicy          String    @default("carnegie")
  policyVersion       String
  requiresHumanReview Boolean   @default(true)
  checks              Json
  status              String    @default("DRAFT")
  reviewedByName      String?
  reviewedAt          DateTime?
  createdByName       String
  generatedAt         DateTime  @default(now())

  @@index([contactId])
  @@index([accountId])
}

/// Mercado M6: a suggested Need that a person said is not a need (so SOLU stops suggesting it). ref = note:<id> | future:<id>
// ---------- Comercial C1 · Technical Discovery & Functional Assembly (module 10 §4–5) ----------

/// One component of the solution in the Assembly Scope Matrix. "Requested" (what the customer literally asked)
/// and "required for function" (what it needs to actually work) are separate facts; status says what we do about it.
model ScopeLine {
  id                  String             @id @default(cuid())
  dealId              String
  deal                Deal               @relation(fields: [dealId], references: [id], onDelete: Cascade)
  position            Int                @default(0)
  component           String
  code                String?
  manufacturer        String?
  qty                 Int                @default(1)
  family              String?
  requested           Boolean            @default(false)
  requiredForFunction Boolean            @default(true)
  /// INCLUDED | EXCLUDED | OPTIONAL | CUSTOMER_SUPPLIED | TO_CONFIRM
  status              String             @default("TO_CONFIRM")
  /// EXACT | PROBABLE | MULTIPLE | UNKNOWN — uncertainty is kept, never rounded up
  identity            String             @default("UNKNOWN")
  /// OEM_NEW | NEW | USED | REFURBISHED | ANY
  condition           String?
  alternativesAllowed Boolean            @default(false)
  note                String?
  source              String?
  confirmationId      String?
  confirmation        ScopeConfirmation? @relation(fields: [confirmationId], references: [id], onDelete: SetNull)
  createdByName       String
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  facts               TechnicalFact[]

  @@index([dealId])
}

/// A technical fact about a scope line (nameplate value, spec). Versioned: a correction supersedes, never overwrites.
model TechnicalFact {
  id             String     @id @default(cuid())
  dealId         String
  deal           Deal       @relation(fields: [dealId], references: [id], onDelete: Cascade)
  scopeLineId    String?
  scopeLine      ScopeLine? @relation(fields: [scopeLineId], references: [id], onDelete: Cascade)
  key            String
  value          String
  /// CONFIRMED (seen on nameplate/document) | REPORTED (someone said it) | HYPOTHESIS (inferred)
  state          String     @default("REPORTED")
  source         String
  evidence       String?
  recordedByName String
  createdAt      DateTime   @default(now())
  supersededAt   DateTime?

  @@index([dealId])
  @@index([scopeLineId])
}

/// What the customer confirmed about the scope (who, how, when, in their words). Resolves ambiguous terms and
/// covers excluded / customer-supplied lines.
model ScopeConfirmation {
  id             String      @id @default(cuid())
  dealId         String
  deal           Deal        @relation(fields: [dealId], references: [id], onDelete: Cascade)
  text           String
  confirmedBy    String
  channel        String
  confirmedAt    DateTime
  terms          String[]    @default([])
  recordedByName String
  createdAt      DateTime    @default(now())
  lines          ScopeLine[]

  @@index([dealId])
}

/// Evidenced, versioned relationship between two products (by code or name). Never an automatic AI equivalence.
model ProductRelationship {
  id             String    @id @default(cuid())
  fromKey        String
  fromLabel      String
  /// PART_OF | ASSEMBLED_WITH | DRIVES | REQUIRES | MATES_WITH | OPTIONAL_WITH | CUSTOMER_REUSES | SOLD_AS_ASSEMBLY | SOLD_SEPARATELY
  kind           String
  toKey          String
  toLabel        String
  evidence       String
  recordedByName String
  createdAt      DateTime  @default(now())
  supersededAt   DateTime?

  @@index([fromKey])
  @@index([toKey])
}

model NeedDismissal {
  id        String   @id @default(cuid())
  ref       String   @unique
  accountId String
  note      String?
  byName    String
  createdAt DateTime @default(now())
}

/// Comercial C2 (v1.1 §45): a request to present/accept a quote version whose projected Eságara is below the policy threshold.
/// The economics the approver saw are frozen in `snapshot`; decisions are never edited, only appended to `history`.
/// status: REQUESTED | APPROVED | REJECTED | RETURNED | EXPIRED
model EsagaraException {
  id              String    @id @default(cuid())
  quoteId         String
  quote           Quote     @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  dealId          String
  accountId       String
  currency        String    @default("USD")
  saleAmount      Decimal   @db.Decimal(14, 2)
  esagaraAmount   Decimal   @db.Decimal(14, 2)
  esagaraPct      Decimal   @db.Decimal(7, 2)
  thresholdPct    Decimal   @db.Decimal(7, 2)
  policyVersion   Int
  reasonCode      String
  narrative       String
  expectedBenefit String
  scope           String
  alternatives    String?
  snapshot        Json
  status          String    @default("REQUESTED")
  requestedById   String
  requestedByName String
  requestedAt     DateTime  @default(now())
  decidedById     String?
  decidedByName   String?
  decidedAt       DateTime?
  comments        String?
  history         Json      @default("[]")

  @@index([status])
  @@index([quoteId])
  @@index([accountId])
}

// ---------- Comercial C3 · Commercial Cash Journey (v1.2 §54–75) ----------

/// Root Cause Contract (§57, §70): money stopped before becoming cash, with its cause. stage DELIVER | INVOICE | COLLECT.
/// The person who moves next (responsible) is not the cause (rootCause). Never deleted: resolved with a date.
model CashBlocker {
  id                 String    @id @default(cuid())
  dealId             String
  deal               Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  stage              String
  shipmentId         String?
  deliveryId         String?
  invoiceId          String?
  readyAt            DateTime?
  blockedSince       DateTime
  blockedValue       Decimal   @db.Decimal(14, 2)
  reasonCode         String
  rootCause          String
  secondaryCause     String?
  narrative          String
  evidence           String?
  responsibleId      String
  responsible        User      @relation("CashBlockerOwner", fields: [responsibleId], references: [id])
  nextMovement       String
  expectedResolution DateTime?
  resolvedAt         DateTime?
  resolvedNote       String?
  createdByName      String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([dealId])
  @@index([resolvedAt])
}

/// Invoice confirmation (§59): each step of the customer's process, kept as history.
/// kind SUBMITTED | RECEIVED | ACCEPTED | REJECTED | APPROVED_FOR_PAYMENT.
model InvoiceStep {
  id        String   @id @default(cuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  kind      String
  at        DateTime
  reference String?
  reason    String?
  evidence  String?
  byName    String
  createdAt DateTime @default(now())

  @@index([invoiceId])
}

/// Payment Map (§59): how the customer receives, validates, approves, schedules and pays. People are Contacts (no copy).
model PaymentMap {
  id            String             @id @default(cuid())
  accountId     String             @unique
  account       Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  process       String?
  portal        String?
  payDays       String?
  documents     String?
  notes         String?
  updatedByName String
  updatedAt     DateTime           @updatedAt
  people        PaymentMapPerson[]
}

/// role RECEIVES | VALIDATES | APPROVES | SCHEDULES | PAYS
model PaymentMapPerson {
  id        String     @id @default(cuid())
  mapId     String
  map       PaymentMap @relation(fields: [mapId], references: [id], onDelete: Cascade)
  role      String
  contactId String
  contact   Contact    @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([mapId, role, contactId])
}

/// Credit limit review (§63): Comercial asks, Finanzas or Gerencia decide (never the requester).
/// kind INCREASE | DECREASE | TEMPORARY_EXCEPTION | TERMS_REVIEW · status OPEN | APPROVED | REJECTED | WITHDRAWN.
model CreditReviewRequest {
  id             String    @id @default(cuid())
  accountId      String
  account        Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  dealId         String?
  deal           Deal?     @relation(fields: [dealId], references: [id], onDelete: SetNull)
  kind           String
  requestedLimit Decimal?  @db.Decimal(14, 2)
  requestedTerms Int?
  until          DateTime?
  reason         String
  info           String?
  alternatives   String[]
  snapshot       Json
  status         String    @default("OPEN")
  requestedById  String
  requestedBy    User      @relation("CreditRequester", fields: [requestedById], references: [id])
  decidedById    String?
  decidedBy      User?     @relation("CreditDecider", fields: [decidedById], references: [id])
  decidedAt      DateTime?
  decisionNote   String?
  approvedLimit  Decimal?  @db.Decimal(14, 2)
  approvedTerms  Int?
  createdAt      DateTime  @default(now())

  @@index([accountId])
  @@index([status])
}

// ---------- Durable worker (2026-11-10) ----------
// Background work that must not depend on someone opening a page. A free GitHub schedule calls
// /api/worker every 15 minutes; each call claims due jobs (FOR UPDATE SKIP LOCKED), retries with backoff,
// and records what it did. Recurring work (mail replies, catalog, payment behavior) is planned as jobs too.
model Job {
  id          String    @id @default(cuid())
  kind        String
  payload     Json      @default("{}")
  // Same key = same job: enqueueing it again while it is pending does nothing.
  dedupeKey   String?   @unique
  status      String    @default("PENDING") // PENDING | RUNNING | DONE | FAILED
  attempts    Int       @default(0)
  maxAttempts Int       @default(5)
  runAfter    DateTime  @default(now())
  lockedAt    DateTime?
  lastError   String?
  result      String?
  createdAt   DateTime  @default(now())
  doneAt      DateTime?

  @@index([status, runAfter])
}

model WorkerRun {
  id         String    @id @default(cuid())
  trigger    String // SCHEDULE | MANUAL | LOCAL
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
  ok         Boolean   @default(false)
  done       Int       @default(0)
  failed     Int       @default(0)
  summary    String?

  @@index([startedAt])
}

// ---------- Comercial C4 · Sourcing & Supply (§6–13) ----------

/// §6: a search made for a Journey is kept — query, where we looked, candidates and why the others were discarded.
model SourcingSearch {
  id             String   @id @default(cuid())
  dealId         String
  deal           Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  query          String
  /// where SOLU looked: CATALOG, HISTORY, OFFERS, WEB, … (what the search actually covered)
  sources        String[] @default([])
  /// [{partId, mpn, brand, score, why}]
  candidates     Json
  /// [{partId, mpn, reason}]
  discarded      Json
  note           String?
  recordedByName String
  createdAt      DateTime @default(now())

  @@index([dealId])
}

/// §12: one supplier's answer for this Journey, field by field with its evidence. A candidate, not a decision.
model SupplyOption {
  id                String                  @id @default(cuid())
  dealId            String
  deal              Deal                    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  supplierId        String
  supplier          Supplier                @relation(fields: [supplierId], references: [id])
  offerId           String?
  offer             SupplierOffer?          @relation(fields: [offerId], references: [id], onDelete: SetNull)
  rfqId             String?
  /// what is offered, in the supplier's words (e.g. "Motor 7.5 kW only")
  label             String
  /// scope lines (C1) this option includes — the basis of Scope Equivalence (§13)
  covers            String[]                @default([])
  includedNote      String?
  excludedNote      String?
  currency          String                  @default("USD")
  price             Decimal?                @db.Decimal(14, 2)
  qty               Int?
  stockQty          Int?
  leadDaysMin       Int?
  leadDaysMax       Int?
  leadTrigger       String?
  validUntil        DateTime?
  condition         String?
  warranty          String?
  incoterm          String?
  pickup            String?
  origin            String?
  hsSupplier        String?
  grossKg           Decimal?                @db.Decimal(10, 3)
  dims              String?
  packages          Int?
  /// QUOTE | VERIFIED_AVAILABILITY | HISTORICAL (§12: never mixed)
  availability      String                  @default("QUOTE")
  /// CONFIRMED | CONDITIONAL | NEEDS_REVIEW | BLOCKED (§11)
  importFeasibility String                  @default("NEEDS_REVIEW")
  importNote        String?
  /// per field: {field: {src, at}} — where each value came from
  evidence          Json                    @default("{}")
  /// CANDIDATE | DISCARDED
  status            String                  @default("CANDIDATE")
  discardReason     String?
  recordedByName    String
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  paymentOptions    SupplierPaymentOption[]
  basesPrimary      SupplyBasis[]           @relation("BasisPrimary")
  basesBackup       SupplyBasis[]           @relation("BasisBackup")

  @@index([dealId])
  @@index([supplierId])
}

/// §9: how this supplier can be paid. Unknown is null — never assumed to be zero or instant.
model SupplierPaymentOption {
  id             String        @id @default(cuid())
  optionId       String
  option         SupplyOption  @relation(fields: [optionId], references: [id], onDelete: Cascade)
  /// WIRE | ACH | CARD | OTHER
  method         String
  surchargePct   Decimal?      @db.Decimal(6, 3)
  fixedFee       Decimal?      @db.Decimal(12, 2)
  fxSpreadPct    Decimal?      @db.Decimal(6, 3)
  daysToRelease  Int?
  releaseTrigger String?
  /// the supplier confirmed these conditions (not our assumption)
  confirmed      Boolean       @default(false)
  source         String?
  note           String?
  createdAt      DateTime      @default(now())
  bases          SupplyBasis[]

  @@index([optionId])
}

/// §12: the documented selection (primary + optional backup) that backs the promise. Versioned: a new
/// selection supersedes the previous one, which stays as history. It never creates a Supplier PO.
model SupplyBasis {
  id              String                 @id @default(cuid())
  dealId          String
  deal            Deal                   @relation(fields: [dealId], references: [id], onDelete: Cascade)
  primaryId       String
  primary         SupplyOption           @relation("BasisPrimary", fields: [primaryId], references: [id])
  backupId        String?
  backup          SupplyOption?          @relation("BasisBackup", fields: [backupId], references: [id])
  paymentOptionId String?
  paymentOption   SupplierPaymentOption? @relation(fields: [paymentOptionId], references: [id], onDelete: SetNull)
  reason          String
  risks           String?
  selectedByName  String
  createdAt       DateTime               @default(now())
  supersededAt    DateTime?

  @@index([dealId])
}

/// §10: one observation of a product's logistics data, with its context. Never a single weight without context;
/// a real measurement at receipt is a new observation and never overwrites history.
model LogisticsObservation {
  id             String    @id @default(cuid())
  partId         String
  part           Part      @relation(fields: [partId], references: [id], onDelete: Cascade)
  supplierId     String?
  supplier       Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  dealId         String?
  /// quantity / configuration / packaging this observation is about
  qtyContext     Int?
  packaging      String?
  netKg          Decimal?  @db.Decimal(10, 3)
  grossKg        Decimal?  @db.Decimal(10, 3)
  lengthCm       Decimal?  @db.Decimal(8, 1)
  widthCm        Decimal?  @db.Decimal(8, 1)
  heightCm       Decimal?  @db.Decimal(8, 1)
  packages       Int?
  origin         String?
  hsSupplier     String?
  /// SUPPLIER_REPORTED | RECEIPT_MEASURED | HISTORICAL | ESTIMATED
  status         String
  source         String
  observedAt     DateTime
  recordedByName String
  createdAt      DateTime  @default(now())

  @@index([partId])
}

/// §11: what happened in a real import — reused as a dated PRECEDENT, never as an automatic authorization.
model ImportExperience {
  id             String   @id @default(cuid())
  partId         String?
  part           Part?    @relation(fields: [partId], references: [id], onDelete: SetNull)
  dealId         String?
  productLabel   String
  /// Colombian tariff subheading actually used (not the supplier's HS)
  hsCode         String?
  hsCriterion    String?
  documents      String?
  approvals      String?
  agentNotes     String?
  inspection     String?
  realCostUsd    Decimal? @db.Decimal(14, 2)
  days           Int?
  delays         String?
  resolution     String?
  importedAt     DateTime
  recordedByName String
  createdAt      DateTime @default(now())

  @@index([partId])
}

// ---------- Comercial C5 · Solution Case & Proposal (§14–20) ----------

/// §17: Industry Solutions value attributes. The 8 from the spec are pre-loaded as DRAFT (decision C-14);
/// Gerencia / Director Comercial review and activate them. Never shown to a customer by themselves.
model ValueAttribute {
  id            String       @id @default(cuid())
  key           String       @unique
  nameEs        String
  nameEn        String
  definitionEs  String
  definitionEn  String
  appliesWhen   String?
  restrictions  String?
  evidenceHint  String?
  /// DRAFT | ACTIVE | RETIRED
  status        String       @default("DRAFT")
  version       Int          @default(1)
  updatedByName String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  claims        ValueClaim[]
}

/// §14: the shared reasoning of a Journey. Not a copy of the Quote: it says why, which routes, what's at stake
/// and what decision is needed.
model SolutionCase {
  id                String               @id @default(cuid())
  dealId            String               @unique
  deal              Deal                 @relation(fields: [dealId], references: [id], onDelete: Cascade)
  understood        String?
  /// [{kind, label, note}] — OEM | ALTERNATIVE | REPAIR | REFURBISHED | EXPEDITE | PARTIAL
  routes            Json?
  operationalImpact String?
  risks             String?
  recommendation    String?
  decisionNeeded    String?
  helpToBuy         String?
  committee         Boolean              @default(false)
  /// QUICK | PROPOSAL chosen by the person; null = follow SOLU's recommendation
  mode              String?
  updatedByName     String
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  claims            ValueClaim[]
  presentations     PresentationRecord[]
}

/// §17 chain NEED → IMPACT → SOLUTION → ATTRIBUTE → ADVANTAGE → BENEFIT → PROOF for this case.
/// Reaches a proposal only with evidence for this case (AC12); without it, it stays an internal hypothesis.
model ValueClaim {
  id            String         @id @default(cuid())
  caseId        String
  case          SolutionCase   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  attributeId   String
  attribute     ValueAttribute @relation(fields: [attributeId], references: [id])
  need          String
  impact        String?
  advantage     String
  benefit       String
  evidence      String?
  evidenceAt    DateTime?
  /// MAINTENANCE | PURCHASING | MANAGEMENT | FINANCE | ALL
  audience      String         @default("ALL")
  validUntil    DateTime?
  hidden        Boolean        @default(false)
  createdByName String
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([caseId])
}

/// §19: what happened when the solution was presented (optional; never required for a simple purchase).
model PresentationRecord {
  id             String       @id @default(cuid())
  caseId         String
  case           SolutionCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  quoteId        String?
  quote          Quote?       @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  at             DateTime
  channel        String
  audience       String?
  changed        String?
  valued         String?
  objections     String?
  whoDecides     String?
  window         String?
  nextMove       String?
  nextMoveDate   DateTime?
  recordedByName String
  createdAt      DateTime     @default(now())

  @@index([caseId])
}

// ---------- Comercial C6 · PO, Acceptance & Dispatch (§22–24, v1.3 §58) ----------

/// §22: one customer PO can cover several Journeys (and a Journey several POs). The PO's own Journey keeps
/// whatever isn't allocated elsewhere. Allocations are audited, never silently moved.
model PoAllocation {
  id            String     @id @default(cuid())
  poId          String
  po            CustomerPO @relation(fields: [poId], references: [id], onDelete: Cascade)
  dealId        String
  deal          Deal       @relation(fields: [dealId], references: [id], onDelete: Cascade)
  amount        Decimal    @db.Decimal(14, 2)
  lineRef       String?
  note          String?
  createdByName String
  createdAt     DateTime   @default(now())

  @@unique([poId, dealId])
  @@index([dealId])
}

/// v1.3 §58: what Commercial promised the customer about delivery, issued to Operations. Commercial defines the
/// customer obligation; Operations owns the physical execution. An issued version is never edited: a change is a new version.
model DispatchInstruction {
  id               String      @id @default(cuid())
  dealId           String
  deal             Deal        @relation(fields: [dealId], references: [id], onDelete: Cascade)
  poId             String?
  po               CustomerPO? @relation(fields: [poId], references: [id], onDelete: SetNull)
  version          Int         @default(1)
  /// [{code, description, qty}]
  items            Json
  destination      String
  contactName      String?
  contactPhone     String?
  windowFrom       DateTime?
  windowTo         DateTime?
  promiseDate      DateTime?
  documents        String?
  entryRequirement String?
  restrictions     String?
  changeReason     String?
  issuedByName     String
  issuedAt         DateTime    @default(now())
  supersededAt     DateTime?

  @@index([dealId])
}

// ---------- Comercial C7 · Goals & Future Creation (v1.1 §37–42, §50) ----------

/// A monthly target for one person and one core goal, set by Gerencia / Director Comercial. Versioned: a change
/// supersedes the current row (kept for history). A closed month can't change. Visible only to the person and
/// their managers; never ranked.
model GoalTarget {
  id           String    @id @default(cuid())
  userId       String
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  metric       String
  period       String
  target       Decimal   @db.Decimal(14, 2)
  rationale    String?
  setByName    String
  version      Int       @default(1)
  supersededAt DateTime?
  createdAt    DateTime  @default(now())

  @@index([userId, period])
}

// ---------- Comercial C8a · Visits & Commercial Missions (v1.3 §57) ----------

/// A planned or unplanned customer visit. The brief is derived from what SOLU already knows (no re-typing); the
/// outcome is typed by the person (no AI drafting while L4 is paused) and every confirmation is theirs.
model VisitPlan {
  id            String             @id @default(cuid())
  accountId     String
  account       Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  plantId       String?
  ownerId       String
  owner         User               @relation("VisitOwner", fields: [ownerId], references: [id])
  missionId     String?
  mission       CommercialMission? @relation(fields: [missionId], references: [id], onDelete: SetNull)
  plannedAt     DateTime?
  unplanned     Boolean            @default(false)
  /// [{ cat: UNDERSTAND|RELATIONSHIP|SOLVE|PRESENT_DECIDE|ACCOMPANY|FUTURE, text }]
  objectives    Json               @default("[]")
  meetWith      String?
  /// PLANNED | DONE | CANCELLED
  status        String             @default("PLANNED")
  happenedAt    DateTime?
  learned       String?
  objectivesMet Json?
  nextMove      String?
  nextMoveDate  DateTime?
  cancelReason  String?
  createdByName String
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  commitments VisitCommitment[]
  attachments VisitAttachment[]

  @@index([ownerId, status])
  @@index([accountId])
}

/// A promise made at a visit, by us or by the customer, tracked until kept or dropped.
model VisitCommitment {
  id         String    @id @default(cuid())
  visitId    String
  visit      VisitPlan @relation(fields: [visitId], references: [id], onDelete: Cascade)
  /// US | CUSTOMER
  side       String
  what       String
  dueAt      DateTime?
  dealId     String?
  /// OPEN | KEPT | DROPPED
  status     String    @default("OPEN")
  closedAt   DateTime?
  closedNote String?
  createdAt  DateTime  @default(now())

  @@index([visitId])
}

/// A trip that groups several visits. The travel budget and expenses belong to Administration (Module 14):
/// until that module exists the mission only records the request.
model CommercialMission {
  id            String   @id @default(cuid())
  title         String
  ownerId       String
  owner         User     @relation("MissionOwner", fields: [ownerId], references: [id])
  destination   String
  startDate     DateTime
  endDate       DateTime
  purpose       String
  travelNote    String?
  /// NOT_REQUESTED | REQUESTED | APPROVED | REJECTED (interim rules until the official Module 14 document, C-17)
  budgetStatus  String   @default("NOT_REQUESTED")
  budgetAmount  Decimal? @db.Decimal(14, 2)
  createdByName String
  createdAt     DateTime @default(now())

  budgetRequestedAt   DateTime?
  budgetApproved      Decimal?  @db.Decimal(14, 2)
  budgetDecidedAt     DateTime?
  budgetDecidedByName String?
  budgetNote          String?
  /// OPEN | SUBMITTED | RETURNED | RECONCILED
  expensesStatus      String    @default("OPEN")
  expensesSubmittedAt DateTime?
  reconciledAt        DateTime?
  reconciledByName    String?
  reconcileNote       String?

  expenses MissionExpense[]
  visits   VisitPlan[]
}

// ---------- Comercial C8b · Absence Coverage (v1.3 §59) ----------

/// Temporary delegated authority: while now is inside [startsAt, endsAt) and it isn't revoked, the acting person
/// may act on the original owner's Journeys. It expires by itself (checked on every request). The original owner
/// stays accountable; role approvals (Eságara, credit, payments) are never delegated by coverage.
/// `handover` keeps the HandoverSnapshot taken when the coverage was created.
model CoverageAssignment {
  id             String    @id @default(cuid())
  originalUserId String
  originalUser   User      @relation("CoverageOriginal", fields: [originalUserId], references: [id], onDelete: Cascade)
  actingUserId   String
  actingUser     User      @relation("CoverageActing", fields: [actingUserId], references: [id], onDelete: Cascade)
  startsAt       DateTime
  endsAt         DateTime
  /// PLANNED | EMERGENCY
  kind           String    @default("PLANNED")
  reason         String
  instructions   String?
  handover       Json      @default("{}")
  createdByName  String
  revokedAt      DateTime?
  revokedByName  String?
  createdAt      DateTime  @default(now())

  @@index([actingUserId, endsAt])
  @@index([originalUserId, endsAt])
}

/// Who knows this customer well enough to step in when the owner is away.
model RelationshipBackup {
  id           String   @id @default(cuid())
  accountId    String   @unique
  account      Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  backupUserId String
  backupUser   User     @relation("RelationshipBackupUser", fields: [backupUserId], references: [id], onDelete: Cascade)
  note         String?
  setByName    String
  updatedAt    DateTime @updatedAt
}

// ---------- Comercial C8d · Visit attachments (v1.3 §57 post-visit photo/document) ----------

/// A photo (shrunk in the browser) or a document attached to a visit. At most 5 per visit. Audio is never stored:
/// voice is turned into text in the person's browser and only the text is kept (decision 2026-11-10).
model VisitAttachment {
  id             String    @id @default(cuid())
  visitId        String
  visit          VisitPlan @relation(fields: [visitId], references: [id], onDelete: Cascade)
  name           String
  mime           String
  size           Int
  data           Bytes
  uploadedByName String
  createdAt      DateTime  @default(now())

  @@index([visitId])
}

/// One travel expense of a mission, with its receipt (photo shrunk in the browser, or PDF) or the reason there is none.
/// Amounts are in USD. Checked against the approved budget by Finanzas or Gerencia, never by the traveller.
model MissionExpense {
  id              String            @id @default(cuid())
  missionId       String
  mission         CommercialMission @relation(fields: [missionId], references: [id], onDelete: Cascade)
  spentOn         DateTime
  /// TRANSPORT | LODGING | MEALS | LOCAL | OTHER
  category        String
  description     String
  amount          Decimal           @db.Decimal(14, 2)
  originalNote    String?
  /// Currency the expense was paid in (USD | COP). mount is always the USD value used against the budget.
  currency        String            @default("USD")
  originalAmount  Decimal?          @db.Decimal(16, 2)
  /// COP per USD used to convert, and where it came from (official TRM of a date, or the amount actually charged).
  fxRate          Decimal?          @db.Decimal(12, 2)
  fxSource        String?
  receiptName     String?
  receiptMime     String?
  receiptSize     Int?
  receiptData     Bytes?
  noReceiptReason String?
  createdByName   String
  createdById     String?
  createdAt       DateTime          @default(now())

  @@index([missionId])
}

// ---------- Selling entities (decision C-02, C-19 to C-21) ----------

/// One of our own companies that can be the seller on a Journey. Public business details only: bank details are
/// never here (they come from the verified bank profile). Edited by Gerencia; every change is audited.
model SellingEntity {
  id            String   @id @default(cuid())
  /// USA | CO
  key           String   @unique
  legalName     String
  /// "EIN", "NIT"…
  taxIdLabel    String?
  taxId         String?
  addressLines  String?
  phone         String?
  country       String
  /// IVA added to quotes of this company, in percent (0 = none).
  ivaPct        Decimal  @default(0) @db.Decimal(5, 2)
  /// May quote in COP as well as USD.
  allowsCop     Boolean  @default(false)
  /// SOLU = SOLU prints the commercial invoice; EXTERNAL = the legal invoice is issued elsewhere (DIAN) and recorded here.
  invoiceMode   String   @default("SOLU")
  active        Boolean  @default(false)
  version       Int      @default(1)
  updatedByName String?
  updatedAt     DateTime @updatedAt
}

// ---------- Operaciones O0 · Operational Exception (module 11 §50) ----------

/// Reality deviated enough from what was expected to need a decision. Never just an alert: it carries the impact,
/// the options, the recommended next move, an owner and a deadline (AC35). `impactAreas` drives the Commercial
/// Impact Gate (§48): Comercial is involved only when promise, scope, price, compliance or relationship are touched.
model OperationalException {
  id                String    @id @default(cuid())
  dealId            String
  deal              Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  supplierPoId      String?
  shipmentId        String?
  /// SUPPLIER_DELAY | MISSING_DOCS | CUSTOMS_HOLD | DAMAGED | WRONG_ITEM | SHORT_SHIPMENT | PAYMENT_NOT_CREDITED |
  /// FREIGHT_VARIANCE | CREDIT_OVEREXPOSURE | UNEXPECTED_INVENTORY | OTHER
  kind              String
  whatHappened      String
  expected          String
  actual            String
  customerImpact    String?
  economicImpactUsd Decimal?  @db.Decimal(14, 2)
  evidence          String?
  rootHypothesis    String?
  /// [string] resolution options considered
  options           Json      @default("[]")
  recommended       String
  /// [PROMISE | SCOPE | PRICE | COMPLIANCE | RELATIONSHIP]
  impactAreas       Json      @default("[]")
  ownerId           String
  owner             User      @relation("ExceptionOwner", fields: [ownerId], references: [id])
  deadline          DateTime
  /// OPEN | RESOLVED
  status            String    @default("OPEN")
  resolution        String?
  resolvedAt        DateTime?
  resolvedByName    String?
  createdByName     String
  createdAt         DateTime  @default(now())

  @@index([status, deadline])
  @@index([dealId])
}

// ---------- Operaciones O1 · Purchase Requirement (module 11 §4–6) ----------

/// What the organisation needs to buy and why; not yet an order to a supplier. Purposes built now (decision O-05):
/// CUSTOMER_FULFILLMENT (must have a Journey, AC1) and INVENTORY. Internal, asset and project purchases wait for
/// Module 14. Quantity bought beyond what is allocated to Journeys is Inventory Exposure and needs its own approval.
model PurchaseRequirement {
  id                 String    @id @default(cuid())
  code               String    @unique
  /// CUSTOMER_FULFILLMENT | INVENTORY
  purpose            String
  /// PRODUCT | SERVICE | MIXED
  itemType           String    @default("PRODUCT")
  /// DIRECT_COST (resale and stock); other natures arrive with Module 14
  economicNature     String    @default("DIRECT_COST")
  sellerKey          String    @default("USA")
  requesterId        String
  requester          User      @relation("PrRequester", fields: [requesterId], references: [id])
  /// Home Journey of a customer purchase (the Supplier PO belongs to it). Null only for INVENTORY.
  dealId             String?
  deal               Deal?     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  supplierId         String?
  supplier           Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  neededBy           DateTime?
  urgent             Boolean   @default(false)
  currency           String    @default("USD")
  justification      String?
  sourceEvidence     String?
  nextMove           String?
  /// Inventory Exposure approval: NONE | REQUESTED | APPROVED | REJECTED, for the unallocated quantity it was asked for.
  stockStatus        String    @default("NONE")
  stockQtyApproved   Int?
  stockAmount        Decimal?  @db.Decimal(14, 2)
  stockRequestedAt   DateTime?
  stockDecidedAt     DateTime?
  stockDecidedByName String?
  stockNote          String?
  supplierPoId       String?   @unique
  cancelledAt        DateTime?
  cancelReason       String?
  createdByName      String
  createdAt          DateTime  @default(now())

  lines     PurchaseRequirementLine[]
  approvals PurchaseApproval[]

  @@index([dealId])
}

model PurchaseRequirementLine {
  id               String              @id @default(cuid())
  prId             String
  pr               PurchaseRequirement @relation(fields: [prId], references: [id], onDelete: Cascade)
  position         Int                 @default(0)
  manufacturer     String?
  code             String?
  description      String
  qty              Int
  unit             String              @default("un")
  spec             String?
  expectedUnitCost Decimal             @default(0) @db.Decimal(14, 2)

  allocations PurchaseAllocation[]

  @@index([prId])
}

/// §5.1: every unit bought for resale is assigned to a Journey. What isn't assigned is inventory, never hidden.
model PurchaseAllocation {
  id     String                  @id @default(cuid())
  lineId String
  line   PurchaseRequirementLine @relation(fields: [lineId], references: [id], onDelete: Cascade)
  dealId String
  deal   Deal                    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  qty    Int

  @@unique([lineId, dealId])
  @@index([dealId])
}

// ---------- Operaciones O2 · Purchase authorization (module 11 §7–11) ----------

/// A request to commit resources for a purchase that is not routine. It carries why it needs approval, the amount and
/// the related commitment total (anti-fragmentation), the level required, the context the approver saw, and the
/// version of the policy applied (a purchase's history is never re-read with a later policy).
model PurchaseApproval {
  id              String              @id @default(cuid())
  prId            String
  pr              PurchaseRequirement @relation(fields: [prId], references: [id], onDelete: Cascade)
  /// [STOCK | COST_ABOVE_PROTECTED | OVER_CREDIT | NEW_SUPPLIER | FULL_ADVANCE]
  reasons         Json
  amount          Decimal             @db.Decimal(14, 2)
  relatedTotal    Decimal             @db.Decimal(14, 2)
  stockQty        Int                 @default(0)
  stockAmount     Decimal             @default(0) @db.Decimal(14, 2)
  level           Int
  /// REQUESTED | APPROVED | RETURNED | REJECTED
  status          String              @default("REQUESTED")
  requestedById   String
  requestedByName String
  requestedAt     DateTime            @default(now())
  requestNote     String?
  context         Json
  decidedById     String?
  decidedByName   String?
  decidedAt       DateTime?
  decisionNote    String?
  escalatedByName String?
  policyVersion   Int

  @@index([prId])
  @@index([status])
}

// ---------- Operaciones O3 · Supplier Confirmation and Savings Ledger (module 11 §12–16) ----------

/// What the supplier confirmed, compared with our Supplier PO. A sent PO is not an accepted PO. `diffs` keeps the
/// comparison as it was when recorded (expected, actual, economic and customer impact); material differences need
/// a written resolution before the order counts as confirmed. Scope is compared on its own, never hidden in price.
model SupplierConfirmation {
  id             String     @id @default(cuid())
  supplierPoId   String
  supplierPo     SupplierPO @relation(fields: [supplierPoId], references: [id], onDelete: Cascade)
  poVersion      Int
  receivedAt     DateTime
  source         String
  /// [{ position, qty, unitPrice }]
  lines          Json
  currency       String?
  readyDate      DateTime?
  paymentTerms   String?
  incoterm       String?
  packaging      String?
  documents      String?
  warranty       String?
  newConditions  String?
  /// [{ component, state: INCLUDED | EXCLUDED | OPTIONAL | NOT_STATED }] for what the functional unit needs
  scope          Json       @default("[]")
  diffs          Json       @default("[]")
  resolution     String?
  resolvedAt     DateTime?
  resolvedByName String?
  recordedByName String
  createdAt      DateTime   @default(now())

  @@index([supplierPoId])
}

/// A verifiable improvement. Not every saving becomes margin: what was passed on to the customer is kept apart
/// from what the company retained. A claim counts only when the credit was really received.
model SavingsEntry {
  id               String      @id @default(cuid())
  /// SUPPLIER_SAVINGS | FREIGHT_SAVINGS | PAYMENT_SAVINGS | LEGITIMATE_DUTY_REDUCTION | CLAIM_RECOVERY | ERROR_AVOIDANCE
  kind             String
  dealId           String?
  deal             Deal?       @relation(fields: [dealId], references: [id], onDelete: SetNull)
  supplierPoId     String?
  supplierPo       SupplierPO? @relation(fields: [supplierPoId], references: [id], onDelete: SetNull)
  supplierId       String?
  baselineAmount   Decimal     @db.Decimal(14, 2)
  baselineSource   String
  finalAmount      Decimal     @db.Decimal(14, 2)
  savingsAmount    Decimal     @db.Decimal(14, 2)
  passedToCustomer Decimal     @default(0) @db.Decimal(14, 2)
  currency         String      @default("USD")
  evidence         String
  note             String?
  responsibleId    String
  responsibleName  String
  at               DateTime
  createdAt        DateTime    @default(now())

  @@index([dealId])
  @@index([supplierId])
}

// ---------- Operaciones O4b · Supplier commitments (module 11 §22–24) ----------

/// Something the supplier said will happen, kept as what it is: reported, committed, or actually occurred. A date
/// the supplier gave is never a fact that happened. Milestones differ by kind of order (stock, manufactured,
/// service, repair). While the expected date is ahead it is a healthy wait and creates no task.
model SupplierCommitment {
  id              String     @id @default(cuid())
  supplierPoId    String
  supplierPo      SupplierPO @relation(fields: [supplierPoId], references: [id], onDelete: Cascade)
  position        Int        @default(0)
  /// milestone key, e.g. PO_CONFIRMED, READY, PRODUCTION, TESTING, PICKUP…
  type            String
  label           String
  expectedDate    DateTime?
  /// PENDING | REPORTED | COMMITTED | OCCURRED
  status          String     @default("PENDING")
  source          String?
  contact         String?
  lastConfirmedAt DateTime?
  occurredAt      DateTime?
  occurredNote    String?
  recordedByName  String?
  createdAt       DateTime   @default(now())

  @@index([supplierPoId])
}

// ---------- Operaciones O5a · Freight requirement and options (module 11 §25–28) ----------

/// What must be moved for one Supplier PO and everything needed before booking transport. Prefilled from the supply
/// basis; each figure keeps who stated it. Logistics Readiness is derived from it, not ticked by hand.
model FreightRequirement {
  id             String     @id @default(cuid())
  supplierPoId   String     @unique
  supplierPo     SupplierPO @relation(fields: [supplierPoId], references: [id], onDelete: Cascade)
  origin         String?
  pickupAddress  String?
  pickupContact  String?
  pickupHours    String?
  destination    String?
  readyDate      DateTime?
  packages       Int?
  netKg          Decimal?   @db.Decimal(10, 2)
  grossKg        Decimal?   @db.Decimal(10, 2)
  dims           String?
  packagingType  String?
  stackable      Boolean?
  fragile        Boolean?
  hazardous      Boolean?
  temperature    String?
  incoterm       String?
  hasInvoice     Boolean    @default(false)
  hasPackingList Boolean    @default(false)
  exportNote     String?
  handling       String?
  insurance      String?
  urgent         Boolean    @default(false)
  /// who stated weight and measures: SUPPLIER_STATED | HISTORICAL_MEASURED | WAREHOUSE_MEASURED | CARRIER_MEASURED | ESTIMATED
  weightSource   String     @default("SUPPLIER_STATED")
  reconfirmedAt  DateTime?
  reconfirmNote  String?
  updatedByName  String
  updatedAt      DateTime   @updatedAt

  quotes FreightQuote[]
}

/// One freight option for a requirement. The measure is cost to fulfil, not the cheapest freight: each option is
/// read against the customer promise. Choosing is a recorded human decision with its reason.
model FreightQuote {
  id             String             @id @default(cuid())
  requirementId  String
  requirement    FreightRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  /// adapter that produced it: MANUAL (typed from a quote) | DHL_EXPRESS …
  adapter        String             @default("MANUAL")
  carrier        String
  service        String?
  mode           String?
  cost           Decimal            @db.Decimal(14, 2)
  /// how the cost is built, when known: {tariff, discountPct, discount, pieceSurcharge, fuel, insurance, extras:[{name, amount}], total}
  breakdown      Json?
  currency       String             @default("USD")
  transitDays    Int?
  pickupDate     DateTime?
  cutoff         String?
  insurance      String?
  customsNote    String?
  reliability    String?
  validUntil     DateTime?
  source         String
  chosen         Boolean            @default(false)
  chosenReason   String?
  chosenByName   String?
  chosenAt       DateTime?
  recordedByName String
  createdAt      DateTime           @default(now())

  @@index([requirementId])
}

// ---------- Operaciones O5b · Carrier accounts and integration evidence (module 11 §53.8–53.9) ----------

/// One of our accounts with a carrier, owned by one of our companies. Credentials are NEVER stored here: `secretRef`
/// names the environment variables that hold them (e.g. DHL_USA → DHL_USA_API_KEY, DHL_USA_API_SECRET,
/// DHL_USA_ACCOUNT). Only the last 4 digits of the account number are kept for recognition.
model CarrierAccount {
  id            String    @id @default(cuid())
  /// adapter key: DHL_EXPRESS …
  carrier       String
  sellerKey     String
  label         String
  accountLast4  String?
  country       String?
  currency      String    @default("USD")
  /// TEST | PRODUCTION
  environment   String    @default("TEST")
  secretRef     String    @unique
  active        Boolean   @default(false)
  effectiveFrom DateTime?
  effectiveTo   DateTime?
  updatedByName String
  updatedAt     DateTime  @updatedAt
  createdAt     DateTime  @default(now())
}

/// Every call to a carrier that matters, so an uncertain result is reconciled before anything is repeated (AC44).
/// Request and response are stored sanitized: no credentials, no full account numbers.
model CarrierIntegrationAttempt {
  id             String    @id @default(cuid())
  adapter        String
  accountId      String?
  /// RATE | CAPABILITY | CREATE_SHIPMENT | PICKUP | TRACKING | POD | DOCUMENT | LANDED_COST
  operation      String
  idempotencyKey String    @unique
  /// PENDING | OK | FAILED | UNCERTAIN
  state          String    @default("PENDING")
  shipmentId     String?
  supplierPoId   String?
  request        Json?
  response       Json?
  error          String?
  byName         String?
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?

  @@index([shipmentId])
  @@index([state])
}

// ---------- Operaciones O6 · Goods receipt, stock and evidence (module 11 §34–36) ----------

/// A place where goods are received and stock can sit (decision O-01: Miami and Colombia; editable later).
model StockLocation {
  id       String         @id @default(cuid())
  key      String         @unique
  name     String
  country  String?
  active   Boolean        @default(true)
  receipts GoodsReceipt[]
  lots     StockLot[]
}

/// One arrival of goods against a Supplier PO. A receipt validates identity, condition and completeness, not only
/// quantity (AC21). Measured weight and dimensions are kept as our own evidence, separate from what was stated.
model GoodsReceipt {
  id             String        @id @default(cuid())
  code           String        @unique
  supplierPoId   String
  supplierPo     SupplierPO    @relation(fields: [supplierPoId], references: [id], onDelete: Cascade)
  locationId     String
  location       StockLocation @relation(fields: [locationId], references: [id])
  receivedAt     DateTime
  receivedById   String
  receivedByName String
  packages       Int?
  grossKg        Decimal?      @db.Decimal(10, 2)
  dims           String?
  packagingOk    Boolean?
  notes          String?
  createdAt      DateTime      @default(now())

  lines  GoodsReceiptLine[]
  photos GoodsReceiptPhoto[]

  @@index([supplierPoId])
}

model GoodsReceiptLine {
  id            String       @id @default(cuid())
  receiptId     String
  receipt       GoodsReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  position      Int
  code          String?
  description   String
  qtyExpected   Int
  qtyReceived   Int
  identityOk    Boolean
  conditionOk   Boolean
  completeOk    Boolean
  docsOk        Boolean
  serials       String?
  /// QUANTITY | IDENTITY | CONDITION | COMPLETENESS | DOCUMENTATION (first that failed; null = clean)
  exceptionKind String?
  exceptionNote String?

  lots StockLot[]

  @@index([receiptId])
}

/// Units physically in a location, in one state. Committed = assigned to a Journey; Available = free to sell;
/// Quarantine / Damaged / Return pending are physically there but never available (AC22–23).
model StockLot {
  id            String           @id @default(cuid())
  receiptLineId String
  receiptLine   GoodsReceiptLine @relation(fields: [receiptLineId], references: [id], onDelete: Cascade)
  locationId    String
  location      StockLocation    @relation(fields: [locationId], references: [id])
  code          String?
  description   String
  qty           Int
  /// COMMITTED | AVAILABLE | RESERVED | QUARANTINE | DAMAGED | RETURN_PENDING
  state         String
  dealId        String?
  deal          Deal?            @relation(fields: [dealId], references: [id], onDelete: SetNull)
  stateNote     String?
  stateByName   String?
  stateAt       DateTime?
  /// Left the location (dispatched to the customer or returned to the supplier): no longer physical stock.
  outAt         DateTime?
  outNote       String?
  createdAt     DateTime         @default(now())

  @@index([locationId, state])
  @@index([dealId])
}

/// Photo evidence of a receipt (shrunk in the browser; at most 8 per receipt, decision O-08).
model GoodsReceiptPhoto {
  id             String       @id @default(cuid())
  receiptId      String
  receipt        GoodsReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  name           String
  mime           String
  size           Int
  data           Bytes
  uploadedByName String
  createdAt      DateTime     @default(now())

  @@index([receiptId])
}

// ---------- Operaciones O7 · Freight audit and customs (module 11 §31–33) ----------

/// How one carrier (and optionally one service) turns size into chargeable weight, and how much difference is normal.
/// Never one formula for everyone (AC19). `confirmed` = checked against our contract; until then it is a starting value.
model CarrierRatingRule {
  id            String   @id @default(cuid())
  carrier       String
  service       String   @default("")
  /// volumetric kg = L × W × H (cm) / divisor
  divisor       Int      @default(5000)
  roundingKg    Decimal  @default(0.5) @db.Decimal(6, 2)
  minChargeKg   Decimal? @db.Decimal(8, 2)
  tolerancePct  Decimal  @default(3) @db.Decimal(6, 2)
  toleranceUsd  Decimal  @default(10) @db.Decimal(10, 2)
  claimPct      Decimal  @default(10) @db.Decimal(6, 2)
  confirmed     Boolean  @default(false)
  note          String?
  version       Int      @default(1)
  updatedByName String?
  updatedAt     DateTime @updatedAt

  @@unique([carrier, service])
}

/// What the carrier actually billed for a shipment, compared with the quote, the waybill data and our own measurement.
model CarrierInvoice {
  id             String   @id @default(cuid())
  shipmentId     String
  shipment       Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  carrier        String
  service        String?
  number         String
  invoiceDate    DateTime
  currency       String   @default("USD")
  amount         Decimal  @db.Decimal(14, 2)
  billedKg       Decimal? @db.Decimal(10, 2)
  billedPieces   Int?
  /// [{ name, amount }]
  surcharges     Json     @default("[]")
  source         String
  /// MATCH | WITHIN_TOLERANCE | VARIANCE_REVIEW | CLAIM_RECOMMENDED | CLAIM_OPEN | CREDIT_RECEIVED
  status         String
  /// the comparison as it was when recorded (expected vs billed, variances, rule version)
  audit          Json
  recordedByName String
  createdAt      DateTime @default(now())

  claim FreightClaim?

  @@unique([carrier, number])
  @@index([shipmentId])
}

/// A dispute with the carrier. It is recovered only when the credit is really received, never on a verbal yes (AC20).
model FreightClaim {
  id              String         @id @default(cuid())
  invoiceId       String         @unique
  invoice         CarrierInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  disputedAmount  Decimal        @db.Decimal(14, 2)
  expectedCalc    String
  billedCalc      String
  evidence        String
  claimDate       DateTime
  /// OPEN | ACCEPTED | REJECTED | RECOVERED
  status          String         @default("OPEN")
  response        String?
  creditNote      String?
  recoveredAmount Decimal?       @db.Decimal(14, 2)
  recoveredAt     DateTime?
  openedByName    String
  updatedByName   String?
  createdAt       DateTime       @default(now())
}

/// Customs for one shipment: documents, classification with where it comes from, duties expected vs actual, holds
/// and release. A classification used before is history, not a currently validated one.
model CustomsCase {
  id                   String    @id @default(cuid())
  shipmentId           String    @unique
  shipment             Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  broker               String?
  consignee            String?
  declarationNo        String?
  classification       String?
  /// PENDING | HISTORICAL | VALIDATED_CURRENT
  classificationStatus String    @default("PENDING")
  classificationSource String?
  origin               String?
  declaredValue        Decimal?  @db.Decimal(14, 2)
  hasTransportDoc      Boolean   @default(false)
  permits              String?
  dutiesExpected       Decimal?  @db.Decimal(14, 2)
  dutiesActual         Decimal?  @db.Decimal(14, 2)
  vatTreatment         String?
  inspection           String?
  holdReason           String?
  correctiveSteps      String?
  expectedDays         Int?
  arrivedAt            DateTime?
  releasedAt           DateTime?
  updatedByName        String
  updatedAt            DateTime  @updatedAt
  createdAt            DateTime  @default(now())
}

// ---------- Operaciones O8 · Dispatch & Delivery (module 11 §38–40, v1.2 §44) ----------

/// The physical execution of one delivery to the customer. Dispatched, Delivered and Invoice Ready are three
/// different facts and are never collapsed. A partial delivery is simply an order with fewer units.
model DispatchOrder {
  id                 String    @id @default(cuid())
  code               String    @unique
  dealId             String
  deal               Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  instructionId      String?
  /// [{dealItemId, code, description, qty}]
  lines              Json
  /// MESSENGER | VEHICLE | NATIONAL_CARRIER | CARRIER_GATEWAY | CUSTOMER_PICKUP | DIRECT_SHIP
  resourceKind       String
  resourceName       String?
  tracking           String?
  scheduledFor       DateTime?
  scheduledByName    String?
  dispatchedAt       DateTime?
  dispatchedByName   String?
  deliveredAt        DateTime?
  deliveryId         String?   @unique
  delivery           Delivery? @relation(fields: [deliveryId], references: [id], onDelete: SetNull)
  cost               Decimal?  @db.Decimal(14, 2)
  costCurrency       String    @default("USD")
  costNote           String?
  /// {requirementId: {by, at}}
  checks             Json      @default("{}")
  /// A wait the customer controls (not ready to receive, appointment pending): distinct from our own delay.
  customerHoldReason String?
  customerHoldSince  DateTime?
  cancelledAt        DateTime?
  cancelReason       String?
  createdByName      String
  createdAt          DateTime  @default(now())

  attempts DeliveryAttempt[]
  evidence DeliveryEvidence[]

  @@index([dealId])
}

/// One attempt to deliver. Never edited or deleted: a failed attempt stays as history.
model DeliveryAttempt {
  id             String        @id @default(cuid())
  orderId        String
  order          DispatchOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  at             DateTime
  /// DELIVERED | FAILED
  outcome        String
  /// CUSTOMER | COMPANY | CARRIER | OTHER (failed attempts only)
  cause          String?
  reason         String?
  receiverName   String?
  recordedByName String
  createdAt      DateTime      @default(now())

  @@index([orderId])
}

model DeliveryEvidence {
  id             String        @id @default(cuid())
  orderId        String
  order          DispatchOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// SIGNED_REMISSION | POD | PHOTO | PORTAL
  kind           String
  name           String
  mime           String
  size           Int
  data           Bytes
  uploadedByName String
  createdAt      DateTime      @default(now())

  @@index([orderId])
}

/// Delivery Profile: what this customer (and optionally one of its sites) requires, by phase.
model DeliveryRequirement {
  id            String   @id @default(cuid())
  accountId     String
  account       Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  site          String   @default("")
  /// BEFORE_DISPATCH | AT_DELIVERY | AFTER_DELIVERY | BEFORE_INVOICE
  phase         String
  text          String
  active        Boolean  @default(true)
  createdByName String
  createdAt     DateTime @default(now())

  @@index([accountId])
}

// ---------- Operaciones O9a · Bank statements and matching (module 11 §42) ----------

/// One of the company's own bank accounts. Only a label and the last four digits: never the full number.
model BankAccount {
  id            String   @id @default(cuid())
  label         String
  bank          String   @default("Bank of America")
  last4         String?
  currency      String   @default("USD")
  sellerKey     String   @default("USA")
  active        Boolean  @default(true)
  createdByName String
  createdAt     DateTime @default(now())

  statements   BankStatement[]
  transactions BankTransaction[]
}

/// One uploaded statement file. The file itself is not kept: only what was read from it.
model BankStatement {
  id             String      @id @default(cuid())
  bankAccountId  String
  bankAccount    BankAccount @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  fileName       String
  periodFrom     DateTime?
  periodTo       DateTime?
  rowsRead       Int
  added          Int
  duplicates     Int
  skipped        Int
  uploadedByName String
  createdAt      DateTime    @default(now())

  transactions BankTransaction[]

  @@index([bankAccountId])
}

/// A movement as the bank reports it. Positive = money in, negative = money out. Never edited.
model BankTransaction {
  id            String         @id @default(cuid())
  bankAccountId String
  bankAccount   BankAccount    @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  statementId   String?
  statement     BankStatement? @relation(fields: [statementId], references: [id], onDelete: SetNull)
  date          DateTime
  amount        Decimal        @db.Decimal(14, 2)
  description   String
  reference     String?
  balance       Decimal?       @db.Decimal(14, 2)
  /// stable identity of the row, so uploading an overlapping statement never duplicates it
  fingerprint   String
  /// null | INTERNAL_TRANSFER | BANK_FEE | OTHER: set by a person, with a note, when it is not a customer or supplier payment
  classifiedAs  String?
  classNote     String?
  classByName   String?
  createdAt     DateTime       @default(now())

  matches BankMatch[]

  @@unique([bankAccountId, fingerprint])
  @@index([bankAccountId, date])
}

/// The link between a bank movement and what SOLU already knows. One movement can pay several things and one
/// payment can arrive in several movements.
model BankMatch {
  id                 String            @id @default(cuid())
  transactionId      String
  transaction        BankTransaction   @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  customerPaymentId  String?
  customerPayment    CustomerPayment?  @relation(fields: [customerPaymentId], references: [id], onDelete: Cascade)
  paymentExecutionId String?
  paymentExecution   PaymentExecution? @relation(fields: [paymentExecutionId], references: [id], onDelete: Cascade)
  amount             Decimal           @db.Decimal(14, 2)
  createdByName      String
  createdAt          DateTime          @default(now())

  @@index([transactionId])
  @@index([customerPaymentId])
  @@index([paymentExecutionId])
}

// ---------- Operaciones O9c · Cost ledger (module 11 §43.1, §44) ----------

/// A real cost of a Journey that no other record already holds (broker, storage, travel, an extra charge), or one
/// Journey's share of a cost shared between several. Costs already recorded elsewhere (supplier orders, carrier
/// invoices, duties, delivery, bank fees) are read from there and never typed again here.
model DealCost {
  id            String   @id @default(cuid())
  dealId        String
  deal          Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  /// SUPPLIER | FREIGHT | DUTY | DELIVERY | BANK_FEE | TRAVEL | OTHER
  category      String
  amount        Decimal  @db.Decimal(14, 2)
  description   String
  evidence      String?
  spentOn       DateTime
  /// same value on every share of one shared cost
  sharedId      String?
  sharedTotal   Decimal? @db.Decimal(14, 2)
  /// VALUE | UNITS | MANUAL: the method is always kept with the split
  splitMethod   String?
  splitNote     String?
  createdByName String
  createdAt     DateTime @default(now())

  @@index([dealId])
  @@index([sharedId])
}

// ---------- Operaciones O9d · Warranty and customer claims (module 11 §45.1) ----------

/// What is under warranty for a delivered Journey: item, serial, start and period. Never edited after a claim exists.
model Warranty {
  id             String   @id @default(cuid())
  dealId         String
  deal           Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  item           String
  serial         String?
  startsOn       DateTime
  months         Int
  terms          String?
  /// the supplier's own warranty behind ours, when known
  supplierName   String?
  supplierMonths Int?
  createdByName  String
  createdAt      DateTime @default(now())

  claims CustomerClaim[]

  @@index([dealId])
}

/// A warranty claim, return or complaint from the customer after delivery. The original delivery history is never
/// changed: the case and its notes are added on top.
model CustomerClaim {
  id             String    @id @default(cuid())
  code           String    @unique
  dealId         String
  deal           Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  warrantyId     String?
  warranty       Warranty? @relation(fields: [warrantyId], references: [id], onDelete: SetNull)
  /// WARRANTY | RETURN | COMPLAINT
  kind           String
  whatHappened   String
  reportedBy     String?
  reportedAt     DateTime
  /// SUPPLIER | COMPANY | CARRIER | CUSTOMER | UNKNOWN
  responsible    String    @default("UNKNOWN")
  /// OPEN | RESOLVED | REJECTED
  status         String    @default("OPEN")
  resolution     String?
  resolvedAt     DateTime?
  resolvedByName String?
  costUsd        Decimal?  @db.Decimal(14, 2)
  createdByName  String
  createdAt      DateTime  @default(now())

  notes ClaimNote[]

  @@index([dealId])
}

model ClaimNote {
  id        String        @id @default(cuid())
  claimId   String
  claim     CustomerClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  text      String
  byName    String
  createdAt DateTime      @default(now())

  @@index([claimId])
}

// ---------- Operaciones O10 · Product experience base (module 11 §36–37) ----------

/// What we learned supplying a product, kept for the team. It can become public content only after a person reviews
/// every confidentiality point; SOLU never publishes anything by itself.
model ProductExperience {
  id               String   @id @default(cuid())
  code             String?
  manufacturer     String?
  title            String
  application      String?
  industry         String?
  summary          String
  dealId           String?
  deal             Deal?    @relation(fields: [dealId], references: [id], onDelete: SetNull)
  /// INTERNAL_ONLY | PUBLISHABLE_ANONYMIZED | CUSTOMER_APPROVED_CASE
  eligibility      String   @default("INTERNAL_ONLY")
  customerApproval String?
  /// {reviewKey: {by, at}}
  checks           Json     @default("{}")
  draft            String?
  createdByName    String
  createdAt        DateTime @default(now())
  updatedByName    String?
  updatedAt        DateTime @updatedAt

  @@index([code])
}

// ---------- Módulo 12 · changing the profitability numbers (§33) ----------

/// A proposed change to the commission numbers or the cost of money. Nothing changes until Gerencia approves it;
/// approval creates new policy VERSIONS, so history is never recalculated.
model PolicyChangeRequest {
  id              String    @id @default(cuid())
  /// the numbers as they were when the change was proposed
  current         Json
  /// the numbers proposed
  proposed        Json
  effectiveFrom   DateTime
  reason          String
  /// PENDING | APPROVED | REJECTED
  status          String    @default("PENDING")
  requestedById   String
  requestedByName String
  requestedAt     DateTime  @default(now())
  decidedByName   String?
  decidedAt       DateTime?
  decisionNote    String?
}

// ---------- Módulo 12 R2 · who shares a sale's commission (§12) ----------

/// One person's share of one function's part of a Journey's commission fund. Set by Gerencia. A change supersedes the
/// current rows (kept as history) and only affects what has not been approved for payment yet.
model CommissionAllocation {
  id           String    @id @default(cuid())
  dealId       String
  deal         Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  userId       String
  user         User      @relation("CommissionShare", fields: [userId], references: [id])
  /// COMMERCIAL | OPERATIONAL
  pool         String
  splitPct     Decimal   @db.Decimal(5, 2)
  reason       String
  setByName    String
  createdAt    DateTime  @default(now())
  supersededAt DateTime?

  @@index([dealId])
  @@index([userId])
}

// ---------- Módulo 12 R4 · monthly commission settlement (§21–22) ----------

/// One approval of everything payable at that moment, for a period. The lines are a frozen copy of what was approved
/// and how it was calculated; a later change never edits a run, it shows up in a later run.
model CommissionSettlementRun {
  id             String    @id @default(cuid())
  /// "YYYY-MM"
  period         String
  version        Int
  /// APPROVED | PAID
  status         String    @default("APPROVED")
  /// [{userId, userName, deal, invoice, half, seq, amount, calc, policyVersion}]
  lines          Json
  total          Decimal   @db.Decimal(14, 2)
  approvedByName String
  approvedAt     DateTime  @default(now())
  paidAt         DateTime?
  paidByName     String?
  payrollRef     String?

  entries CommissionEntry[]

  @@unique([period, version])
}

// ---------- Authorisation by level (company ranges, 2025 table as the starting policy) ----------

/// Who authorised a Journey of a given size, according to the ranges in force that day. A record of a fact: the
/// amounts, the exchange rate and the policy version are kept as they were.
model DealAuthorization {
  id             String   @id @default(cuid())
  dealId         String
  deal           Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  amountUsd      Decimal  @db.Decimal(14, 2)
  amountCop      Decimal  @db.Decimal(18, 2)
  trm            Decimal  @db.Decimal(12, 2)
  trmSource      String
  /// level of the person who owns the Journey that day
  level          String
  /// PERSONAL | PEER | SENIOR_PEER | MMS_MENTOR | GERENCIA
  step           String
  authorizedBy   String
  mentorInformed String?
  partnersNote   String?
  note           String?
  policyVersion  Int
  recordedByName String
  createdAt      DateTime @default(now())

  @@index([dealId])
}

// ---------- Módulo 13 · simple teams (decision I-02; Module 16 may redefine them) ----------

/// A group of people under one leader, set by Gerencia. Used only to scope reports: the leader sees the team's
/// results. It grants no authority to edit or approve anything.
model Team {
  id            String   @id @default(cuid())
  name          String
  leaderId      String
  leader        User     @relation("TeamLeader", fields: [leaderId], references: [id])
  active        Boolean  @default(true)
  createdByName String
  createdAt     DateTime @default(now())

  members TeamMember[]
}

model TeamMember {
  id        String   @id @default(cuid())
  teamId    String
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([teamId, userId])
  @@index([userId])
}

// ---------- Módulo 13 · monthly close of the Business Pulse (§24) ----------

/// The pulse of a month as it stood when it was closed. A closed month shows these figures and is never silently
/// recalculated; reopening needs Gerencia and a reason, and the earlier close stays as history.
model PulseSnapshot {
  id             String    @id @default(cuid())
  /// "YYYY-MM"
  period         String
  version        Int
  data           Json
  closedByName   String
  closedAt       DateTime  @default(now())
  reopenedAt     DateTime?
  reopenedByName String?
  reopenReason   String?

  @@unique([period, version])
}
