generator client {
  provider        = "prisma-client-js"
  // One SQL query per findMany (LATERAL JOINs) instead of one round-trip per relation level:
  // pages with nested includes need far fewer trips to the database (Neon).
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Business role names the team recognizes (user decision 2026-11-09). Old → new: ADMIN → GERENCIA,
// MANAGER → DIRECTOR_COMERCIAL, REP → NEGOCIADOR_COMERCIAL. NEGOCIADOR_OPERATIVO and FINANZAS are new.
enum Role {
  GERENCIA
  DIRECTOR_COMERCIAL
  NEGOCIADOR_COMERCIAL
  NEGOCIADOR_OPERATIVO
  FINANZAS
  MARKETING
}

enum Lang {
  ES
  EN
}

enum DealStage {
  LEAD
  QUALIFIED
  PROPOSAL
  NEGOTIATION
  WON
  LOST
}

enum TaskStatus {
  OPEN
  DONE
}

enum ActivityType {
  CALL
  MEETING
  EMAIL
  NOTE
}

enum CommissionHalf {
  SALE
  COLLECTION
}

// Users are deactivated, never deleted, so ownership history stays intact.
model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  name               String
  passwordHash       String
  role               Role      @default(NEGOCIADOR_COMERCIAL)
  active             Boolean   @default(true)
  lang               Lang      @default(ES)
  // Length of a normal working day, used by Mi Plan to size capacity.
  workdayMinutes     Int       @default(570)
  // Outlook calendar of the person's own mailbox (login email), read and written via Microsoft Graph.
  outlookConnectedAt DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  accounts   Account[]
  deals      Deal[]
  tasks      Task[]
  activities Activity[]

  paymentsRequested   SupplierPayment[]   @relation("PaymentRequester")
  paymentsVerified    SupplierPayment[]   @relation("PaymentVerifier")
  paymentsApproved    SupplierPayment[]   @relation("PaymentApprover")
  paymentsExecuted    SupplierPayment[]   @relation("PaymentExecutor")
  invoicesIssued      Invoice[]
  promisesRecorded    PaymentPromise[]
  cashRecorded        CustomerPayment[]   @relation("CashRecorder")
  billingRequests     BillingRequest[]
  cashReconciled      CustomerPayment[]   @relation("CashReconciler")
  commissionsEarned   CommissionEntry[]   @relation("CommissionOwner")
  commissionsApproved CommissionEntry[]   @relation("CommissionApprover")
  creditExceptions    Deal[]              @relation("CreditException")
  suppliersVerified   Supplier[]
  journeyViews        JourneyView[]
  commMessages        CommMessage[]
  commDecisions       CommItem[]
  quotesCreated       Quote[]
  explorations        Exploration[]       @relation("ExplorationOwner")
  futuresOwned        FutureOpportunity[] @relation("FutureOwner")
}

model Account {
  id        String   @id @default(cuid())
  name      String
  industry  String?
  website   String?
  phone     String?
  address   String?
  ownerId   String
  owner     User     @relation(fields: [ownerId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Commercial and billing terms
  taxId                 String?
  taxDataComplete       Boolean   @default(false)
  creditLimit           Decimal?  @db.Decimal(14, 2)
  paymentTermsDays      Int       @default(30)
  requiresReceptionCode Boolean   @default(false)
  requiresPortal        Boolean   @default(false)
  portalValidUntil      DateTime?
  isDemo                Boolean   @default(false)
  // Default language of the documents sent to this customer (Quote, Invoice).
  docLang               Lang      @default(EN)
  // Billing profile: whether the customer accepts one invoice per partial delivery, and who receives invoices.
  allowsPartialBilling  Boolean   @default(true)
  billingContact        String?

  contacts      Contact[]
  outboundMails OutboundMail[]
  deals         Deal[]
  tasks         Task[]
  activities    Activity[]
  invoices      Invoice[]
  payments      CustomerPayment[]
  threads       CommThread[]
  documents     AccountDocument[]
  plants        Plant[]
  marketSignals MarketSignal[]
  gaps          KnowledgeGap[]
  whiteSpaces   WhiteSpace[]
  futures       FutureOpportunity[]
  aliases       AccountAlias[]
  insights      AccountInsight[]
  employments   Employment[]
  marketCompany MarketCompany?
  payBehaviors  PaymentBehaviorSnapshot[]
  openLoops     OpenLoop[]
  prepared      PreparedMessage[]

  @@index([ownerId])
  @@index([name])
}

// Company documents of a customer (RUT, Cámara de Comercio certificate, others).
// `extracted` keeps what SOLU read from the file, so a person can see where a field came from.
model AccountDocument {
  id           String   @id @default(cuid())
  accountId    String
  account      Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  kind         String // RUT | CAMARA | OTHER
  name         String
  mime         String
  size         Int
  data         Bytes
  extracted    Json?
  uploadedById String?
  createdAt    DateTime @default(now())

  @@index([accountId])
}

model Contact {
  id        String   @id @default(cuid())
  firstName String
  lastName  String
  email     String?
  phone     String?
  title     String?
  accountId String?
  account   Account? @relation(fields: [accountId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  deals       Deal[]
  tasks       Task[]
  activities  Activity[]
  threads     CommThread[]
  employments Employment[]
  personNotes PersonNote[]
  openLoops   OpenLoop[]
  prepared    PreparedMessage[]

  @@index([accountId])
  @@index([lastName, firstName])
}

// A Deal is the commercial heart of a Journey (J-YYMM-####): need, customer PO,
// purchase, delivery, invoice, cash and the customer's result.
model Deal {
  id        String    @id @default(cuid())
  code      String?   @unique
  title     String
  amount    Decimal   @default(0) @db.Decimal(14, 2)
  stage     DealStage @default(LEAD)
  closeDate DateTime?
  accountId String
  account   Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contactId String?
  contact   Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  ownerId   String
  owner     User      @relation(fields: [ownerId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  desiredResult         String?
  customerPo            String?
  poAcceptedAt          DateTime?
  promisedDate          DateTime?
  promiseText           String?
  supplierCost          Decimal     @default(0) @db.Decimal(14, 2)
  freightCost           Decimal     @default(0) @db.Decimal(14, 2)
  otherCosts            Decimal     @default(0) @db.Decimal(14, 2)
  nextMove              String?
  nextMoveDate          DateTime?
  waitingFor            String?
  waitingUntil          DateTime?
  resultAchievedAt      DateTime?
  offerValidUntil       DateTime?
  creditExceptionById   String?
  creditExceptionBy     User?       @relation("CreditException", fields: [creditExceptionById], references: [id])
  creditExceptionAt     DateTime?
  creditExceptionNote   String?
  // Journey Workspace: what is needed, how it is measured and what it costs not to solve it.
  needSpecs             String?
  neededBy              DateTime?
  successMeasure        String?
  impactIfNot           String?
  sourcingNote          String?
  incoterm              String?
  paymentTerms          String?
  quoteSentAt           DateTime?
  resultNote            String?
  // Result & Closure: desired result vs actual result, confirmed with evidence (delivery is not the result).
  resultState           ResultState @default(PENDING)
  actualResult          String?
  reliefNote            String?
  resultPendingNote     String?
  resultConfirmedAt     DateTime?
  resultConfirmedByName String?
  closedAt              DateTime?
  closedByName          String?
  closureSummary        String?
  closureLearning       String?
  closureNoSignalReason String?
  // Promise performance: the first promise is kept; later changes count as revisions (when, and why).
  originalPromisedDate  DateTime?
  promiseRevisions      Int         @default(0)
  promiseRevisedAt      DateTime?
  promiseChangeCause    String?
  // Mercado M6 (§12): a Need confirmed from Mercado keeps where it came from and what Mercado knew then.
  explorationId         String?
  exploration           Exploration? @relation(fields: [explorationId], references: [id], onDelete: SetNull)
  plantId               String?
  plant                 Plant?       @relation(fields: [plantId], references: [id], onDelete: SetNull)
  /// note:<id> | future:<id> | signal:<id> — the evidence the Need was confirmed from
  originRef             String?
  /// Frozen copy of the inherited context at confirmation (items with their source ids).
  needContext           Json?

  // Comercial C1 · Technical & Scope
  scopeLines          ScopeLine[]
  technicalFacts      TechnicalFact[]
  scopeConfirmations  ScopeConfirmation[]

  resultEvidence  ResultEvidence[]
  recoveries      Recovery[]
  continuity      ContinuitySignal[]
  tasks           Task[]
  views           JourneyView[]
  threads         CommThread[]
  quotes          Quote[]
  customerPos     CustomerPO[]
  activities      Activity[]
  items           DealItem[]
  supplierPos     SupplierPO[]
  rfqs            Rfq[]
  shipments       Shipment[]
  deliveries      Delivery[]
  invoices        Invoice[]
  billingRequests BillingRequest[]

  @@index([stage])
  @@index([ownerId])
  @@index([accountId])
}

enum ResultState {
  PENDING
  PARTIAL
  ACHIEVED
  NOT_ACHIEVED
  NO_LONGER_RELEVANT
}

// What the customer said, a technical fact, a visit or a measurement. It supports, partly supports
// or contradicts the desired result. Only evidence (never the delivery itself) confirms a result.
model ResultEvidence {
  id             String   @id @default(cuid())
  dealId         String
  deal           Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  kind           String
  stance         String
  text           String
  who            String?
  source         String?
  at             DateTime
  recordedByName String
  createdAt      DateTime @default(now())

  @@index([dealId])
}

// Opened when the product arrived but the result is at risk or wasn't achieved.
model Recovery {
  id             String    @id @default(cuid())
  dealId         String
  deal           Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  openedAt       DateTime  @default(now())
  openedByName   String
  whatChanged    String
  impact         String
  // Material cause: SPEC / SUPPLIER / LOGISTICS / CUSTOMER / COST / OTHER
  cause          String?
  options        Json
  selectedKey    String?
  selectedAt     DateTime?
  selectedByName String?
  selectedNote   String?
  expectedBy     DateTime?
  resolvedAt     DateTime?
  outcome        String?
  outcomeNote    String?

  @@index([dealId])
}

// A legitimate reason to come back (signal) or a concrete condition/date to act on (trigger).
// Not an opportunity: it creates no Journey and no pipeline value.
model ContinuitySignal {
  id            String    @id @default(cuid())
  dealId        String
  deal          Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  kind          String
  what          String
  basis         String
  triggerOn     DateTime?
  triggerEvent  String?
  createdByName String
  createdAt     DateTime  @default(now())
  resolvedAt    DateTime?

  @@index([dealId])
}

// Observed knowledge about a product, keyed by its code: alias, packing, compatibility, spec.
// Every fact keeps where it came from and when it was observed (freshness + provenance).
model ProductFact {
  id             String   @id @default(cuid())
  code           String
  kind           String
  text           String
  source         String?
  observedAt     DateTime
  recordedByName String
  createdAt      DateTime @default(now())

  @@index([code])
}

// ---------- Spare Parts Localization L3: supplier offers ----------
// A supplier's official quote or proforma invoice (the file is kept as evidence). Its lines become SupplierOffers.
// Bank details printed on a proforma are NEVER used: payments only use the supplier's verified bank profile.
model SupplierDoc {
  id             String          @id @default(cuid())
  supplierId     String
  supplier       Supplier        @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  kind           String // QUOTE | PROFORMA
  reference      String? // the supplier's own number
  issuedAt       DateTime?
  validUntil     DateTime?
  currency       String?
  incoterm       String?
  leadText       String?
  paymentTerms   String?
  fileName       String
  mime           String
  size           Int
  data           Bytes
  text           String? // text read from the PDF (audit / re-reading)
  extracted      Json? // what SOLU read (header + candidate lines), shown for review
  bankWarning    String? // the document shows bank details that don't match the verified profile
  rfqRecipientId String?         @unique
  rfqRecipient   RfqRecipient?   @relation(fields: [rfqRecipientId], references: [id], onDelete: SetNull)
  reviewedAt     DateTime?
  createdByName  String
  createdAt      DateTime        @default(now())
  offers         SupplierOffer[]

  @@index([supplierId])
}

// One price for one part from one supplier, with its conditions and where it came from.
model SupplierOffer {
  id             String       @id @default(cuid())
  partId         String
  part           Part         @relation(fields: [partId], references: [id], onDelete: Cascade)
  supplierId     String
  supplier       Supplier     @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  docId          String?
  doc            SupplierDoc? @relation(fields: [docId], references: [id], onDelete: SetNull)
  codeAsQuoted   String
  description    String?
  qty            Int?
  unitPrice      Decimal      @db.Decimal(14, 4)
  currency       String
  leadDaysMin    Int?
  leadDaysMax    Int?
  leadText       String?
  validUntil     DateTime?
  incoterm       String?
  condition      String? // NEW | REFURBISHED | USED
  source         String?
  recordedByName String
  createdAt      DateTime     @default(now())

  @@index([partId])
  @@index([supplierId])
}

// A public web page or distributor API result found for a part (L5). Evidence only: never a price
// we committed to. Kept with the date it was read, so stale data shows as stale.
model WebSource {
  id           String   @id @default(cuid())
  partId       String
  part         Part     @relation(fields: [partId], references: [id], onDelete: Cascade)
  kind         String // PAGE | MOUSER | DIGIKEY | SITEMAP
  url          String
  host         String
  title        String?
  mpnSeen      String?
  brand        String?
  matched      Boolean  @default(false) // the page/API shows this exact part number
  price        Decimal? @db.Decimal(14, 4)
  currency     String?
  priceBreaks  Json? // [{qty, price}]
  stock        Int?
  availability String?
  leadText     String?
  lifecycle    String?
  datasheetUrl String?
  fetchedAt    DateTime @default(now())
  savedByName  String?
  createdAt    DateTime @default(now())

  @@unique([partId, url])
  @@index([partId])
}

// Cache of polite fetches: robots.txt, sitemaps and pages (so we never hammer a site).
model WebCache {
  url         String   @id
  status      Int
  contentType String?
  body        String?
  fetchedAt   DateTime @default(now())
}

// A request for quotation sent from sales@ to several suppliers (one separate email each).
model Rfq {
  /// One key per RFQ form: a double click never creates two RFQs.
  idemKey       String?        @unique
  id            String         @id @default(cuid())
  code          String         @unique
  dealId        String?
  deal          Deal?          @relation(fields: [dealId], references: [id], onDelete: SetNull)
  items         Json // [{partId, mpn, name, brand, qty}]
  lang          String         @default("EN")
  neededBy      DateTime?
  /// Only when the Journey is really urgent does the email say URGENT (no artificial pressure).
  urgent        Boolean        @default(false)
  notes         String?
  subject       String
  body          String
  createdById   String
  createdByName String
  createdAt     DateTime       @default(now())
  recipients    RfqRecipient[]
}

model RfqRecipient {
  id         String       @id @default(cuid())
  rfqId      String
  rfq        Rfq          @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  supplierId String
  supplier   Supplier     @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  email      String
  status     String // SENT | FAILED | ANSWERED | DECLINED
  sentAt     DateTime?
  error      String?
  answeredAt DateTime?
  /// E2: first reply seen in the sales@ inbox (not the same as a registered quote).
  repliedAt  DateTime?
  doc        SupplierDoc?

  @@index([rfqId])
  @@index([supplierId])
}

// Every paid AI call, with its cost, so the monthly cap (AI_MONTHLY_CAP_USD) can be enforced and shown.
model AiUsage {
  id           String   @id @default(cuid())
  feature      String // PART_PHOTO, ...
  model        String
  inputTokens  Int
  outputTokens Int
  costUsd      Decimal  @db.Decimal(10, 5)
  ok           Boolean  @default(true)
  userName     String?
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

// ---------- Spare Parts Localization: the parts catalog ----------
// One canonical record per part (schema.org Product-style fields). Quote, Journey and PO lines
// keep their free-text codes; they are matched to a Part through its normalized code and aliases.
model Part {
  id               String   @id @default(cuid())
  mpn              String // canonical part number, as displayed
  mpnKey           String   @unique // normalized: upper case, letters and digits only
  brand            String?
  name             String // description (Spanish)
  nameEn           String?
  category         String? // product line: MECANICA, ELECTRONICA, ELECTRICA, NEUMATICA, HIDRAULICA, METROLOGIA, AUTOMATIZACION, LUBRICACION, INSTRUMENTAL
  gtin             String?
  condition        String? // NEW | REFURBISHED | USED
  lifecycle        String? // ACTIVE | DISCONTINUED | OBSOLETE
  specs            Json? // [{k, v}]
  compatibleModels String[] @default([])
  notes            String?
  // A duplicate merged into its canonical part keeps existing (so old links still resolve).
  mergedIntoId     String?
  mergedInto       Part?    @relation("PartMerge", fields: [mergedIntoId], references: [id])
  merged           Part[]   @relation("PartMerge")
  createdByName    String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  aliases    PartAlias[]
  offers     SupplierOffer[]
  webSources WebSource[]

  @@index([brand])
  @@index([mergedIntoId])
  @@index([mpnKey(ops: raw("gin_trgm_ops"))], type: Gin, map: "Part_mpnKey_trgm")
}

// Every other number or name the same part is known by, with where it came from.
model PartAlias {
  id            String   @id @default(cuid())
  partId        String
  part          Part     @relation(fields: [partId], references: [id], onDelete: Cascade)
  code          String
  codeKey       String
  kind          String // OEM | AFTERMARKET | CROSSREF | SUPERSEDED | VARIANT | MERGED | NAME
  brand         String?
  source        String?
  createdByName String?
  createdAt     DateTime @default(now())

  @@unique([partId, codeKey])
  @@index([codeKey])
  @@index([codeKey(ops: raw("gin_trgm_ops"))], type: Gin, map: "PartAlias_codeKey_trgm")
}

// Product health of SOLU itself (never of people): a person reports that SOLU made them
// re-enter something it already knew, warned without need, or failed to warn.
model ProductSignal {
  id             String    @id @default(cuid())
  kind           String // REENTRY / ATTENTION_NOISE / ATTENTION_MISSED
  screen         String?
  note           String
  reportedByName String
  createdAt      DateTime  @default(now())
  resolvedAt     DateTime?

  @@index([createdAt])
}

model DealItem {
  id          String  @id @default(cuid())
  dealId      String
  deal        Deal    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  qty         Int
  code        String?
  description String
  unitPrice   Decimal @db.Decimal(14, 2)

  deliveryLines DeliveryLine[]

  @@index([dealId])
}

// Last time each person opened a Journey, to answer "what changed since I last looked?".
model JourneyView {
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  dealId     String
  deal       Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  seenAt     DateTime
  prevSeenAt DateTime?

  @@id([userId, dealId])
}

model Task {
  id              String       @id @default(cuid())
  title           String
  dueDate         DateTime?
  status          TaskStatus   @default(OPEN)
  completedAt     DateTime?
  estimateMinutes Int?
  plannedFor      DateTime?
  scheduledAt     DateTime?
  outlookEventId  String?
  assigneeId      String
  assignee        User         @relation(fields: [assigneeId], references: [id])
  accountId       String?
  account         Account?     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contactId       String?
  contact         Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  dealId          String?
  deal            Deal?        @relation(fields: [dealId], references: [id], onDelete: Cascade)
  explorationId   String?
  exploration     Exploration? @relation(fields: [explorationId], references: [id], onDelete: Cascade)
  createdAt       DateTime     @default(now())

  @@index([assigneeId, status])
}

model Activity {
  id         String       @id @default(cuid())
  type       ActivityType
  subject    String
  body       String?
  occurredAt DateTime     @default(now())
  userId     String
  user       User         @relation(fields: [userId], references: [id])
  accountId  String?
  account    Account?     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contactId  String?
  contact    Contact?     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  dealId     String?
  deal       Deal?        @relation(fields: [dealId], references: [id], onDelete: Cascade)
  // Journey Workspace: which phase this fact feeds, where it came from, and whether it still needs confirming.
  phase      String?
  source     String?
  uncertain  Boolean      @default(false)

  @@index([accountId, occurredAt])
  @@index([occurredAt])
}

// ---------- Suppliers and purchasing ----------

model Supplier {
  id               String    @id @default(cuid())
  name             String
  country          String?
  currency         String    @default("USD")
  email            String?
  // Phone registered when the supplier was onboarded; used for independent verification.
  phone            String?
  // Verified bank profile. Only changed through an independent verification.
  bankBeneficiary  String?
  bankName         String?
  bankAccount      String?
  bankSwift        String?
  bankVerifiedAt   DateTime?
  bankVerifiedById String?
  bankVerifiedBy   User?     @relation(fields: [bankVerifiedById], references: [id])
  isDemo           Boolean   @default(false)
  createdAt        DateTime  @default(now())
  // Commercial terms the supplier usually gives (used to prepare the Supplier PO and its payment milestones).
  paymentTerms     String?
  advancePct       Int       @default(100)
  transitDays      Int?
  // Public website, used to look for part pages via its sitemap (robots.txt is always obeyed).
  website          String?
  /// NIT / tax ID. Same NIT as a customer = the same organization with both roles (Mercado §4.3).
  taxId            String?

  pos           SupplierPO[]
  docs          SupplierDoc[]
  offers        SupplierOffer[]
  rfqRecipients RfqRecipient[]
  outboundMails OutboundMail[]
}

model SupplierPO {
  id               String    @id @default(cuid())
  code             String    @unique
  dealId           String
  deal             Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  supplierId       String
  supplier         Supplier  @relation(fields: [supplierId], references: [id])
  amount           Decimal   @db.Decimal(14, 2)
  currency         String    @default("USD")
  confirmedAt      DateTime?
  shippedAt        DateTime?
  eta              DateTime?
  receivedAt       DateTime?
  // Carrier's own ETA (a separate truth from SOLU's expected date and the customer promise).
  carrierName      String?
  tracking         String?
  carrierEta       DateTime?
  carrierEtaAt     DateTime?
  carrierEtaSource String?
  createdAt        DateTime  @default(now())
  // Versioned document: released terms are not edited; a change creates the next version.
  version          Int       @default(1)
  releasedAt       DateTime?
  releasedByName   String?
  incoterm         String?
  terms            String?
  proformaRef      String?
  shipBy           DateTime?
  costNote         String?
  history          Json?

  lines        SupplierPOLine[]
  requirements PaymentRequirement[]
  payments     SupplierPayment[]
  shipments    Shipment[]

  @@index([dealId])
}

model SupplierPayment {
  id               String              @id @default(cuid())
  supplierPoId     String
  supplierPo       SupplierPO          @relation(fields: [supplierPoId], references: [id], onDelete: Cascade)
  amount           Decimal             @db.Decimal(14, 2)
  currency         String              @default("USD")
  amountUsd        Decimal?            @db.Decimal(14, 2)
  reason           String
  dueBy            DateTime?
  // Bank data as it appears on the supplier's proforma / invoice / instruction.
  docBeneficiary   String?
  docBankName      String?
  docAccount       String?
  docSwift         String?
  docSource        String?
  requestedById    String
  requestedBy      User                @relation("PaymentRequester", fields: [requestedById], references: [id])
  verifiedById     String?
  verifiedBy       User?               @relation("PaymentVerifier", fields: [verifiedById], references: [id])
  verifiedAt       DateTime?
  verificationNote String?
  approvedById     String?
  approvedBy       User?               @relation("PaymentApprover", fields: [approvedById], references: [id])
  approvedAt       DateTime?
  executedById     String?
  executedBy       User?               @relation("PaymentExecutor", fields: [executedById], references: [id])
  executedAt       DateTime?
  executedRef      String?
  createdAt        DateTime            @default(now())
  // Payment Requirement this request pays (milestone), and the separate execution attempts.
  requirementId    String?
  requirement      PaymentRequirement? @relation(fields: [requirementId], references: [id], onDelete: SetNull)
  dupCheckedByName String?
  dupCheckNote     String?
  executions       PaymentExecution[]

  @@index([supplierPoId])
}

// ---------- Delivery, invoicing and cash ----------

model Delivery {
  id             String   @id @default(cuid())
  code           String   @unique
  dealId         String
  deal           Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  deliveredAt    DateTime
  place          String?
  deliveredBy    String?
  receivedByName String?
  podReceived    Boolean  @default(false)
  receptionCode  String?
  notes          String?
  createdAt      DateTime @default(now())

  lines           DeliveryLine[]
  shipment        Shipment?
  invoice         Invoice?
  billingRequests BillingRequest[]

  @@index([dealId])
}

// Billing evidence asked of the customer (POD, receiving code, PO, portal, tax data).
// Resolved when the evidence is recorded, not when someone says it was sent.
model BillingRequest {
  id            String    @id @default(cuid())
  dealId        String
  deal          Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  deliveryId    String?
  delivery      Delivery? @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  kind          String
  sentTo        String?
  note          String?
  requestedAt   DateTime  @default(now())
  requestedById String
  requestedBy   User      @relation(fields: [requestedById], references: [id])
  resolvedAt    DateTime?

  @@index([dealId])
}

model DeliveryLine {
  id         String   @id @default(cuid())
  deliveryId String
  delivery   Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  dealItemId String
  dealItem   DealItem @relation(fields: [dealItemId], references: [id], onDelete: Cascade)
  qty        Int
  serials    String?
}

// Quotes and invoices share one 9-digit sequence.
model DocSequence {
  id   String @id
  next Int
}

model Invoice {
  id            String    @id @default(cuid())
  number        String    @unique
  dealId        String
  deal          Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  deliveryId    String?   @unique
  delivery      Delivery? @relation(fields: [deliveryId], references: [id], onDelete: SetNull)
  accountId     String
  account       Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  issuedAt      DateTime
  dueAt         DateTime
  amount        Decimal   @db.Decimal(14, 2)
  // Esagra of this invoice at the moment it was issued (basis for the sale half of the commission).
  esagraAtIssue Decimal   @db.Decimal(14, 2)
  issuedById    String
  issuedBy      User      @relation(fields: [issuedById], references: [id])
  createdAt     DateTime  @default(now())

  applications   PaymentApplication[]
  promises       PaymentPromise[]
  commissions    CommissionEntry[]
  quoteId        String?
  quote          Quote?               @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  docLang        Lang                 @default(EN)
  // Partial invoice (covers only part of the ordered quantities).
  partial        Boolean              @default(false)
  // Controlled bridge to the accounting system: SOLU's invoice is the business object;
  // the accounting ID is recorded only when the accounting system confirms it.
  externalSystem String?
  externalId     String?
  syncState      AccountingSync       @default(NOT_SENT)
  syncAt         DateTime?
  syncNote       String?
  // Why the customer paid less (withholding, deduction, bank fee). The balance stays open until resolved.
  shortPayNote   String?

  @@index([accountId])
  @@index([dueAt])
}

enum AccountingSync {
  NOT_SENT
  SENT
  CONFIRMED
  UNCERTAIN
}

model CustomerPayment {
  id             String    @id @default(cuid())
  accountId      String
  account        Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  amount         Decimal   @db.Decimal(14, 2)
  receivedAt     DateTime
  reference      String?
  reconciledAt   DateTime?
  reconciledById String?
  reconciledBy   User?     @relation("CashReconciler", fields: [reconciledById], references: [id])
  createdById    String
  createdBy      User      @relation("CashRecorder", fields: [createdById], references: [id])
  createdAt      DateTime  @default(now())
  // What to do with cash left over after allocation (credit on account, refund, ask the customer).
  residualNote   String?

  applications PaymentApplication[]

  @@index([accountId])
}

model PaymentApplication {
  id        String          @id @default(cuid())
  paymentId String
  payment   CustomerPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceId String
  invoice   Invoice         @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount    Decimal         @db.Decimal(14, 2)

  @@index([invoiceId])
}

model PaymentPromise {
  id           String   @id @default(cuid())
  invoiceId    String
  invoice      Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  promisedFor  DateTime
  promisedBy   String
  source       String
  recordedById String
  recordedBy   User     @relation(fields: [recordedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([invoiceId])
}

// ---------- Commissions ----------

model CommissionPolicy {
  id             String   @id @default(cuid())
  version        Int      @unique
  effectiveFrom  DateTime
  // [{ "min": 0, "rate": 0 }, { "min": 12, "rate": 8 }, { "min": 18, "rate": 10 }]  (percent)
  tiers          Json
  newClientBonus Decimal  @default(2) @db.Decimal(5, 2)
  salePercent    Int      @default(50)
  lossDays       Int      @default(90)
  approvedBy     String
  notes          String?
  createdAt      DateTime @default(now())
}

// Snapshot written when management approves a half; paid when payroll confirms it.
model CommissionEntry {
  id           String         @id @default(cuid())
  invoiceId    String
  invoice      Invoice        @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  half         CommissionHalf
  userId       String
  user         User           @relation("CommissionOwner", fields: [userId], references: [id])
  amount       Decimal        @db.Decimal(14, 2)
  calculation  String
  approvedById String
  approvedBy   User           @relation("CommissionApprover", fields: [approvedById], references: [id])
  approvedAt   DateTime       @default(now())
  paidAt       DateTime?
  payrollRef   String?

  @@unique([invoiceId, half])
  @@index([userId])
}

// ---------- Communication Intelligence ----------
// Only conversations with known customers (or messages someone registers by hand).
// SOLU separates what the customer said (FACT) from what it infers (INFERENCE); a person confirms.

enum CommChannel {
  WHATSAPP
  EMAIL
  CALL
  NOTE
}

enum CommDirection {
  IN
  OUT
}

model CommThread {
  id          String      @id @default(cuid())
  channel     CommChannel
  subject     String?
  externalKey String?     @unique
  partyName   String?
  partyAddr   String?
  accountId   String?
  account     Account?    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contactId   String?
  contact     Contact?    @relation(fields: [contactId], references: [id], onDelete: SetNull)
  dealId      String?
  deal        Deal?       @relation(fields: [dealId], references: [id], onDelete: SetNull)
  lastAt      DateTime
  lastInAt    DateTime?
  lastOutAt   DateTime?
  closedAt    DateTime?
  createdAt   DateTime    @default(now())

  messages CommMessage[]
  items    CommItem[]

  @@index([lastAt])
  @@index([accountId])
}

model CommMessage {
  id          String        @id @default(cuid())
  threadId    String
  thread      CommThread    @relation(fields: [threadId], references: [id], onDelete: Cascade)
  direction   CommDirection
  authorName  String
  body        String
  sentAt      DateTime
  externalId  String?       @unique
  createdById String?
  createdBy   User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now())

  attachments CommAttachment[]

  @@index([threadId, sentAt])
}

model CommAttachment {
  id        String      @id @default(cuid())
  messageId String
  message   CommMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  name      String
  mime      String
  size      Int
  data      Bytes
  createdAt DateTime    @default(now())
}

model CommItem {
  id          String     @id @default(cuid())
  threadId    String
  thread      CommThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  field       String
  value       String
  basis       String
  evidence    String
  reasoning   String?
  status      String     @default("PROPOSED")
  decidedById String?
  decidedBy   User?      @relation(fields: [decidedById], references: [id], onDelete: SetNull)
  decidedAt   DateTime?
  createdAt   DateTime   @default(now())

  @@index([threadId])
}

// ---------- Quotes ----------
// A Quote is the solution that protects a customer result. Drafts are internal; presenting
// freezes the version and protects its economics. Any later change is "Rev. N" with the same number.

enum QuoteStatus {
  DRAFT
  PRESENTED
  SUPERSEDED
  ACCEPTED
  DECLINED
}

model Quote {
  id          String      @id @default(cuid())
  dealId      String
  deal        Deal        @relation(fields: [dealId], references: [id], onDelete: Cascade)
  number      String
  rev         Int         @default(0)
  status      QuoteStatus @default(DRAFT)
  lang        Lang        @default(EN)
  createdById String
  createdBy   User        @relation(fields: [createdById], references: [id])
  createdAt   DateTime    @default(now())
  issuedAt    DateTime?
  presentedAt DateTime?
  decidedAt   DateTime?

  // The solution
  solution           String?
  supplyPrimary      String?
  supplyAlt          String?
  promiseText        String?
  promiseCondition   String?
  // Landed cost (current version), each component with its source
  costCurrency       String    @default("USD")
  fxRate             Decimal?  @db.Decimal(14, 6)
  fxSource           String?
  supplierCost       Decimal   @default(0) @db.Decimal(14, 2)
  supplierSrc        String?
  freightCost        Decimal   @default(0) @db.Decimal(14, 2)
  freightSrc         String?
  otherCosts         Decimal   @default(0) @db.Decimal(14, 2)
  otherSrc           String?
  changeNote         String?
  // Protected economics: fixed when presented, never changed afterwards
  protSale           Decimal?  @db.Decimal(14, 2)
  protCost           Decimal?  @db.Decimal(14, 2)
  protEsagra         Decimal?  @db.Decimal(14, 2)
  protPolicy         Int?
  // Terms printed on the document
  billTo             String?
  shipTo             String?
  leadMinDays        Int?
  leadMaxDays        Int?
  incoterm           String?
  paymentTerms       String?
  validityDays       Int       @default(30)
  condition          String    @default("New & original")
  // Customer decision future
  supplierValidUntil DateTime?
  supplyConfirmed    Boolean   @default(false)
  decisionAt         DateTime?
  decisionLabel      String?
  decisionPath       String?
  decisionEvidence   String?
  promiseDecideBy    DateTime?

  lines       QuoteLine[]
  scenarios   QuoteScenario[]
  invoices    Invoice[]
  customerPos CustomerPO[]
  esagaraExceptions EsagaraException[]

  @@unique([number, rev])
  @@index([dealId])
}

model QuoteLine {
  id          String  @id @default(cuid())
  quoteId     String
  quote       Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  position    Int     @default(0)
  qty         Int
  code        String?
  description String
  unitPrice   Decimal @db.Decimal(14, 2)
}

model QuoteScenario {
  id          String  @id @default(cuid())
  quoteId     String
  quote       Quote   @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  position    Int     @default(0)
  label       String
  price       Decimal @db.Decimal(14, 2)
  cost        Decimal @db.Decimal(14, 2)
  leadMinDays Int
  leadMaxDays Int
  risk        String
  promise     String
  recommended Boolean @default(false)
  why         String?
}

// ---------- Customer PO received ----------
// A PO is compared with the quote it answers before anything is promised.
// Accepting it is a Command (PoAcceptance, immutable, with its preconditions and effects), never a status edit.

enum ResolutionOption {
  AMEND_DATE
  EXPEDITE_ABSORB
  EXPEDITE_CHARGE
}

enum ResolutionState {
  REQUESTED
  CONFIRMED
  WITHDRAWN
}

model CustomerPO {
  id             String    @id @default(cuid())
  dealId         String
  deal           Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  quoteId        String?
  quote          Quote?    @relation(fields: [quoteId], references: [id], onDelete: SetNull)
  number         String
  receivedAt     DateTime
  requiredBy     DateTime?
  incoterm       String?
  paymentTerms   String?
  shipTo         String?
  currency       String    @default("USD")
  quoteRef       String?
  source         String?
  createdById    String
  createdByName  String
  createdAt      DateTime  @default(now())
  rejectedAt     DateTime?
  rejectedByName String?
  rejectReason   String?

  lines       CustomerPOLine[]
  resolutions PoResolution[]
  acceptance  PoAcceptance?

  @@index([dealId])
}

model CustomerPOLine {
  id          String     @id @default(cuid())
  poId        String
  po          CustomerPO @relation(fields: [poId], references: [id], onDelete: Cascade)
  position    Int        @default(0)
  qty         Int
  code        String?
  description String
  unitPrice   Decimal    @db.Decimal(14, 2)
}

model PoResolution {
  id              String           @id @default(cuid())
  poId            String
  po              CustomerPO       @relation(fields: [poId], references: [id], onDelete: Cascade)
  field           String
  option          ResolutionOption
  state           ResolutionState  @default(REQUESTED)
  promiseDate     DateTime
  costDelta       Decimal          @default(0) @db.Decimal(14, 2)
  priceDelta      Decimal          @default(0) @db.Decimal(14, 2)
  scenarioLabel   String?
  message         String?
  evidence        String?
  chosenById      String
  chosenByName    String
  chosenAt        DateTime         @default(now())
  confirmedByName String?
  confirmedAt     DateTime?

  @@index([poId])
}

model PoAcceptance {
  id             String     @id @default(cuid())
  poId           String     @unique
  po             CustomerPO @relation(fields: [poId], references: [id], onDelete: Cascade)
  acceptedById   String
  acceptedByName String
  acceptedAt     DateTime   @default(now())
  promiseDate    DateTime
  resolutionId   String?
  // What was true when the command ran: comparison, preconditions and effects.
  snapshot       Json
}

model SupplierPOLine {
  id           String     @id @default(cuid())
  supplierPoId String
  supplierPo   SupplierPO @relation(fields: [supplierPoId], references: [id], onDelete: Cascade)
  position     Int        @default(0)
  qty          Int
  code         String?
  description  String
  unitCost     Decimal    @db.Decimal(14, 2)
}

// What must be paid and when (a milestone of the supplier's terms). It is not a request and not a payment.
model PaymentRequirement {
  id           String     @id @default(cuid())
  supplierPoId String
  supplierPo   SupplierPO @relation(fields: [supplierPoId], references: [id], onDelete: Cascade)
  position     Int        @default(0)
  label        String
  percent      Int
  amount       Decimal    @db.Decimal(14, 2)
  trigger      String
  dueBy        DateTime?

  payments SupplierPayment[]
}

enum ExecutionState {
  SENT
  UNCERTAIN
  CONFIRMED
  FAILED
}

// An attempt to move the money outside SOLU (bank portal). Only CONFIRMED means paid.
model PaymentExecution {
  id             String          @id @default(cuid())
  paymentId      String
  payment        SupplierPayment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  amount         Decimal         @db.Decimal(14, 2)
  sentAt         DateTime
  bankRef        String?
  state          ExecutionState  @default(SENT)
  note           String?
  recordedById   String
  recordedByName String
  resolvedAt     DateTime?
  resolvedByName String?
  evidence       String?
  createdAt      DateTime        @default(now())

  @@index([paymentId])
}

// ---------- Logistics Forward View ----------
// A Shipment is its own object: physical movement with the carrier's truth (ETA, scans),
// kept apart from SOLU's expected delivery and from the customer promise (on the Deal).
enum ShipmentMode {
  AIR
  COURIER
  OCEAN
  GROUND
}

enum CustomsState {
  NOT_REQUIRED
  PENDING
  HOLD
  CLEARED
}

enum ReceiptState {
  PENDING
  CONFIRMED
  DISPUTED
}

enum ShipEventKind {
  SCAN
  ETA_CHANGE
  EXCEPTION
  CUSTOMS
  DELIVERED
  NOTE
}

model Shipment {
  id               String       @id @default(cuid())
  code             String       @unique
  dealId           String
  deal             Deal         @relation(fields: [dealId], references: [id], onDelete: Cascade)
  supplierPoId     String?
  supplierPo       SupplierPO?  @relation(fields: [supplierPoId], references: [id], onDelete: SetNull)
  carrierName      String
  tracking         String?
  mode             ShipmentMode @default(AIR)
  origin           String?
  destination      String?
  destLat          Float?
  destLng          Float?
  international    Boolean      @default(true)
  // true = the carrier hands it to the customer; false = it arrives to us/our broker first
  toCustomer       Boolean      @default(false)
  // Baseline (what we planned when it was recorded) vs actual
  plannedRts       DateTime?
  rtsAt            DateTime?
  plannedPickup    DateTime?
  pickedUpAt       DateTime?
  plannedDelivery  DateTime?
  carrierEta       DateTime?
  carrierEtaAt     DateTime?
  carrierEtaSource String?
  deliveredAt      DateTime?
  deliveredNote    String?
  customs          CustomsState @default(NOT_REQUIRED)
  customsNote      String?
  docs             Json?
  receipt          ReceiptState @default(PENDING)
  receivedAt       DateTime?
  receivedByName   String?
  receiptNote      String?
  disputedAt       DateTime?
  disputeNote      String?
  deliveryId       String?      @unique
  delivery         Delivery?    @relation(fields: [deliveryId], references: [id], onDelete: SetNull)
  createdByName    String
  createdAt        DateTime     @default(now())

  lines     ShipmentLine[]
  events    ShipmentEvent[]
  decisions ShipmentDecision[]

  @@index([dealId])
}

model ShipmentLine {
  id          String   @id @default(cuid())
  shipmentId  String
  shipment    Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  dealItemId  String?
  qty         Int
  description String
}

model ShipmentEvent {
  id             String        @id @default(cuid())
  shipmentId     String
  shipment       Shipment      @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  at             DateTime
  kind           ShipEventKind @default(SCAN)
  location       String?
  lat            Float?
  lng            Float?
  text           String
  // Material = changes the outcome or needs a person. Normal scans are summarised, never notified.
  material       Boolean       @default(false)
  etaBefore      DateTime?
  etaAfter       DateTime?
  source         String?
  recordedByName String?

  @@index([shipmentId, at])
}

model ShipmentDecision {
  id            String    @id @default(cuid())
  shipmentId    String
  shipment      Shipment  @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  option        String
  title         String
  note          String?
  newExpected   DateTime?
  decidedByName String
  decidedAt     DateTime  @default(now())
}

// E2: every email SOLU sends from sales@, so replies can be matched (read-only, Mail.Read).
// Reply facts are per template and per supplier only: no sender/user field on purpose
// (no per-person metrics). The text of the reply is not stored, only a short preview.
model OutboundMail {
  id             String    @id @default(cuid())
  template       String // RFQ | FOLLOWUP | NEGOTIATE | DELIVERY | OFFER | PAYMENT
  refKind        String // RFQR | OFFER | SPO | QUOTE | INVOICE
  refId          String
  refCode        String?
  partyKind      String // SUPPLIER | CUSTOMER
  supplierId     String?
  supplier       Supplier? @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  accountId      String?
  account        Account?  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  dealId         String?
  toAddr         String
  subject        String
  sentAt         DateTime  @default(now())
  /// E-safety: SENDING → SENT | FAILED | UNCERTAIN (network cut mid-send: reconciled against Sent Items before any retry).
  status         String    @default("SENT")
  /// One key per compose screen / RFQ form: a double click or a resubmit never sends twice.
  idemKey        String?   @unique
  error          String?
  conversationId String?
  repliedAt      DateTime?
  replyFrom      String?
  replySubject   String?
  replyPreview   String?
  autoReplyAt    DateTime?
  bouncedAt      DateTime?

  @@index([conversationId])
  @@index([supplierId])
  @@index([template])
  @@index([refKind, refId])
  @@index([sentAt])
  @@index([status])
}

/// #4 Audit trail (constitution No Debt Zone): every material change — money, bank data, authority,
/// states and document versions — with who, when, before and after. Written automatically by db.ts.
/// Rows are never edited or deleted by the app.
model AuditEvent {
  id        String   @id @default(cuid())
  at        DateTime @default(now())
  actorId   String?
  actorName String
  model     String
  entityId  String
  action    String // CREATE | UPDATE | DELETE
  changes   Json // { field: [before, after] }; bank account numbers are stored masked

  @@index([model, entityId])
  @@index([at])
}

// ===================== MERCADO (Módulo 09 · Mercadeo Exploratorio) =====================
// Provenance on every material fact: sourceType · sourceRef · observedAt · confidence · capturedBy.
// confidence: VERIFIED | REPORTED | INFERRED | UNKNOWN. INFERRED never becomes VERIFIED without new evidence.

/// A deliberate investigation with a purpose. Not a lead and not a Journey.
model Exploration {
  id                  String    @id @default(cuid())
  name                String
  purpose             String
  hypothesis          String?
  /// TERRITORY | INDUSTRY | COMPANY | PLANT | TECHNOLOGY | APPLICATION
  scope               String    @default("INDUSTRY")
  scopeText           String?
  ownerId             String
  owner               User      @relation("ExplorationOwner", fields: [ownerId], references: [id])
  startedAt           DateTime  @default(now())
  nextReviewAt        DateTime?
  /// MOVE | WAIT | TRIGGER | CLARITY_NEEDED (always one of them)
  movement            String    @default("CLARITY_NEEDED")
  nextMove            String?
  nextMoveAt          DateTime?
  waitingFor          String?
  waitingUntil        DateTime?
  triggerOn           DateTime?
  triggerEvent        String?
  /// ACTIVE | DORMANT | CLOSED
  lifecycle           String    @default("ACTIVE")
  resultSummary       String?
  closedAt            DateTime?
  createdFromSignalId String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  links       ExplorationLink[]
  signals     MarketSignal[]
  gaps        KnowledgeGap[]
  whiteSpaces WhiteSpace[]
  futures     FutureOpportunity[]
  tasks       Task[]
  deals       Deal[]

  @@index([lifecycle, movement])
}

/// What an exploration is about: companies, plants, suppliers, brands, product codes.
model ExplorationLink {
  id            String      @id @default(cuid())
  explorationId String
  exploration   Exploration @relation(fields: [explorationId], references: [id], onDelete: Cascade)
  /// ACCOUNT | PLANT | SUPPLIER | CONTACT | BRAND | PART_CODE
  kind          String
  refId         String
  label         String
  why           String?
  createdAt     DateTime    @default(now())

  @@unique([explorationId, kind, refId])
}

/// An observed change that deserves understanding. Signal ≠ Need ≠ Opportunity.
model MarketSignal {
  id             String       @id @default(cuid())
  /// EXPANSION | NEW_PLANT | INVESTMENT | ACQUISITION | NEW_TECHNOLOGY | DISCONTINUATION | REGULATORY | ECONOMIC | SHUTDOWN | ROLE_CHANGE | OTHER
  kind           String
  what           String
  whyMatters     String?
  accountId      String?
  account        Account?     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  plantId        String?
  plant          Plant?       @relation(fields: [plantId], references: [id], onDelete: SetNull)
  explorationId  String?
  exploration    Exploration? @relation(fields: [explorationId], references: [id], onDelete: SetNull)
  /// NEW | EXPLORING | DISMISSED
  status         String       @default("NEW")
  dismissedNote  String?
  sourceType     String
  sourceRef      String?
  observedAt     DateTime
  confidence     String       @default("REPORTED")
  capturedById   String?
  capturedByName String
  createdAt      DateTime     @default(now())

  @@index([status])
}

/// Something worth learning that we don't know yet. Can become a Next Movement.
model KnowledgeGap {
  id             String       @id @default(cuid())
  question       String
  why            String?
  explorationId  String?
  exploration    Exploration? @relation(fields: [explorationId], references: [id], onDelete: Cascade)
  accountId      String?
  account        Account?     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  plantId        String?
  plant          Plant?       @relation(fields: [plantId], references: [id], onDelete: Cascade)
  /// OPEN | RESOLVED
  status         String       @default("OPEN")
  answer         String?
  answerSource   String?
  resolvedAt     DateTime?
  resolvedByName String?
  createdByName  String
  createdAt      DateTime     @default(now())

  @@index([status])
}

/// A part of a company or market we haven't explored or served yet.
model WhiteSpace {
  id            String       @id @default(cuid())
  /// PLANT | AREA | COUNTRY | TECHNOLOGY | PERSON | APPLICATION | GROUP_COMPANY | CATEGORY
  kind          String
  what          String
  why           String?
  accountId     String?
  account       Account?     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  explorationId String?
  exploration   Exploration? @relation(fields: [explorationId], references: [id], onDelete: Cascade)
  /// OPEN | EXPLORING | RESOLVED | NOT_RELEVANT
  status        String       @default("OPEN")
  note          String?
  createdByName String
  createdAt     DateTime     @default(now())
  resolvedAt    DateTime?

  @@index([status])
}

/// An operating site of a company (not just an address).
model Plant {
  id             String   @id @default(cuid())
  accountId      String
  account        Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name           String
  city           String?
  country        String?
  operationType  String?
  notes          String?
  sourceType     String
  sourceRef      String?
  observedAt     DateTime
  confidence     String   @default("REPORTED")
  capturedByName String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  signals     MarketSignal[]
  gaps        KnowledgeGap[]
  futures     FutureOpportunity[]
  assets      InstalledAsset[]
  impacts     ImpactProfile[]
  insights    AccountInsight[]
  employments Employment[]
  deals       Deal[]

  @@index([accountId])
}

/// Other names the same organization goes by (Mercado §4.3): legal name, trade name, acronym.
model AccountAlias {
  id            String   @id @default(cuid())
  accountId     String
  account       Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  name          String
  kind          String   @default("TRADE") // LEGAL | TRADE | ACRONYM
  createdByName String
  createdAt     DateTime @default(now())

  @@unique([accountId, name])
}

/// "How this account works" (Mercado §7, §4.16–4.18): one observation with its evidence.
/// block = OPERATE | DECIDE | BUY | VALUE | HURT. DECIDE rows form the Decision Map (area + step + condition).
/// Observations are never overwritten: a replaced one keeps supersededAt and the reason.
model AccountInsight {
  id             String    @id @default(cuid())
  accountId      String
  account        Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  plantId        String?
  plant          Plant?    @relation(fields: [plantId], references: [id], onDelete: Cascade)
  block          String
  topic          String?
  area           String?
  step           String?
  condition      String?
  statement      String
  evidence       String?
  sourceType     String
  sourceRef      String?
  observedAt     DateTime
  confidence     String    @default("REPORTED")
  capturedByName String
  supersededAt   DateTime?
  supersededNote String?
  createdAt      DateTime  @default(now())

  @@index([accountId, block])
}

/// Installed equipment observed at a plant (Mercado §4.8). Plant → process → line → asset.
model InstalledAsset {
  id              String   @id @default(cuid())
  plantId         String
  plant           Plant    @relation(fields: [plantId], references: [id], onDelete: Cascade)
  process         String?
  line            String?
  name            String
  manufacturer    String?
  model           String?
  serial          String?
  operationalRole String?
  redundancy      String   @default("UNKNOWN") // NONE | PARTIAL | FULL | UNKNOWN
  critical        Boolean  @default(false)
  criticalWhy     String?
  knownComponents String?
  sourceType      String
  sourceRef       String?
  observedAt      DateTime
  confidence      String   @default("REPORTED")
  capturedByName  String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  impacts ImpactProfile[]

  @@index([plantId])
}

/// What a stop costs (Mercado §4.19, §8): always a range with its basis, never false precision.
/// level REPORTED = the customer's own figure; GUIDED = SOLU computed it from the inputs below.
model ImpactProfile {
  id               String          @id @default(cuid())
  plantId          String
  plant            Plant           @relation(fields: [plantId], references: [id], onDelete: Cascade)
  assetId          String?
  asset            InstalledAsset? @relation(fields: [assetId], references: [id], onDelete: SetNull)
  scope            String
  stopsLine        String          @default("UNKNOWN") // YES | PARTIAL | NO | UNKNOWN
  timeToImpact     String?
  level            String          @default("REPORTED")
  currency         String          @default("COP")
  costPerHourMin   Decimal?        @db.Decimal(16, 2)
  costPerHourMax   Decimal?        @db.Decimal(16, 2)
  unitsPerHour     Decimal?        @db.Decimal(14, 2)
  contributionUnit Decimal?        @db.Decimal(16, 2)
  scrapPerHour     Decimal?        @db.Decimal(16, 2)
  idleLaborPerHour Decimal?        @db.Decimal(16, 2)
  restartCost      Decimal?        @db.Decimal(16, 2)
  basis            String?
  sourceType       String
  sourceRef        String?
  observedAt       DateTime
  confidence       String          @default("REPORTED")
  capturedByName   String
  createdAt        DateTime        @default(now())

  @@index([plantId])
}

/// A person's job at a company (Mercado §4.10): person (Contact) ≠ employment. Dates, plant, area, real role.
/// No psychological profiles or personal data without a business reason.
model Employment {
  id             String    @id @default(cuid())
  contactId      String
  contact        Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  accountId      String
  account        Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  plantId        String?
  plant          Plant?    @relation(fields: [plantId], references: [id], onDelete: SetNull)
  area           String?
  role           String?
  startedOn      DateTime?
  endedOn        DateTime?
  sourceType     String
  sourceRef      String?
  confidence     String    @default("REPORTED")
  capturedByName String
  createdAt      DateTime  @default(now())

  @@index([accountId])
  @@index([contactId])
}

/// Future that is not a Need or a quote yet (Mercado v2.2 §41). No invented probabilities.
model FutureOpportunity {
  id             String       @id @default(cuid())
  /// CAPEX | SHUTDOWN | NEW_PLANT | RETROFIT | TECH_CHANGE | REGULATORY | STRATEGIC
  kind           String
  description    String
  accountId      String?
  account        Account?     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  plantId        String?
  plant          Plant?       @relation(fields: [plantId], references: [id], onDelete: SetNull)
  process        String?
  explorationId  String?
  exploration    Exploration? @relation(fields: [explorationId], references: [id], onDelete: SetNull)
  /// When it is expected to happen (drives the 0–30 / 31–90 / 91–365 / >365 day horizon).
  expectedAt     DateTime?
  triggerOn      DateTime?
  triggerEvent   String?
  ownerId        String?
  owner          User?        @relation("FutureOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  impact         String?
  valueBasis     String?
  gaps           String?
  nextMove       String?
  nextMoveAt     DateTime?
  /// OPEN | CONVERTED | CLOSED
  status         String       @default("OPEN")
  closedNote     String?
  dealId         String?
  sourceType     String
  sourceRef      String?
  observedAt     DateTime
  confidence     String       @default("REPORTED")
  capturedByName String
  createdAt      DateTime     @default(now())

  @@index([status, expectedAt])
}

/// Mercado M3 · where economic data comes from (§9.1). The column mapping is reusable per source.
model IntelligenceSource {
  id            String              @id @default(cuid())
  name          String              @unique
  kind          String              @default("OTHER") // SUPERSOCIEDADES | CAMARA | SECTOR | PROVIDED | INTERNAL | OTHER
  description   String?
  mapping       Json?
  createdByName String
  createdAt     DateTime            @default(now())
  imports       DatasetImport[]
  snapshots     FinancialSnapshot[]
}

/// One uploaded file (§9.2, §23). The original file is kept as evidence; rows are staged before any canonical write.
/// status: PARSED | MAPPING_REQUIRED | REVIEW_REQUIRED | READY_TO_COMMIT | COMMITTED | FAILED | DISCARDED
model DatasetImport {
  id              String              @id @default(cuid())
  sourceId        String
  source          IntelligenceSource  @relation(fields: [sourceId], references: [id])
  fileName        String
  mime            String
  size            Int
  hash            String              @unique
  data            Bytes
  status          String              @default("PARSED")
  headers         Json
  preview         Json
  rowCount        Int                 @default(0)
  mapping         Json?
  scale           String?
  currency        String?
  decimalStyle    String?
  fixedYear       Int?
  okCount         Int                 @default(0)
  errorCount      Int                 @default(0)
  reviewCount     Int                 @default(0)
  failure         String?
  createdByName   String
  createdAt       DateTime            @default(now())
  committedAt     DateTime?
  committedByName String?
  rows            DatasetRow[]
  snapshots       FinancialSnapshot[]
}

/// Staging row. status OK | ERROR | REVIEW | SKIPPED; decision INCLUDE | EXCLUDE for REVIEW rows.
model DatasetRow {
  id       String        @id @default(cuid())
  importId String
  import   DatasetImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  rowNo    Int
  nit      String?
  year     Int?
  name     String?
  parsed   Json?
  status   String
  messages String[]
  decision String?

  @@index([importId, status])
  @@index([importId, nit, year])
}

/// A company as seen in economic datasets, keyed by NIT (first 9 digits). Linked to a customer/prospect by NIT.
model MarketCompany {
  id         String              @id @default(cuid())
  nit        String              @unique
  name       String
  otherNames String[]
  ciiu       String?
  sector     String?
  department String?
  city       String?
  accountId  String?             @unique
  account    Account?            @relation(fields: [accountId], references: [id], onDelete: SetNull)
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  snapshots  FinancialSnapshot[]

  @@index([name])
}

/// Immutable yearly figures from one import (§9.4). Amounts in currency units (scale already applied).
/// A later file for the same year is another version, never an overwrite.
model FinancialSnapshot {
  id                 String             @id @default(cuid())
  companyId          String
  company            MarketCompany      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fiscalYear         Int
  sourceId           String
  source             IntelligenceSource @relation(fields: [sourceId], references: [id])
  importId           String
  import             DatasetImport      @relation(fields: [importId], references: [id])
  currency           String
  unitsScale         String
  revenue            Decimal?           @db.Decimal(22, 2)
  operatingIncome    Decimal?           @db.Decimal(22, 2)
  netIncome          Decimal?           @db.Decimal(22, 2)
  assets             Decimal?           @db.Decimal(22, 2)
  liabilities        Decimal?           @db.Decimal(22, 2)
  equity             Decimal?           @db.Decimal(22, 2)
  currentAssets      Decimal?           @db.Decimal(22, 2)
  currentLiabilities Decimal?           @db.Decimal(22, 2)
  debt               Decimal?           @db.Decimal(22, 2)
  employees          Int?
  createdAt          DateTime           @default(now())

  @@unique([companyId, fiscalYear, importId])
  @@index([fiscalYear])
}

/// Versioned settings decided by management (e.g. thresholds for economic signals, decision log §32).
model MarketSetting {
  id            String   @id @default(cuid())
  key           String
  version       Int
  value         Json
  updatedByName String
  createdAt     DateTime @default(now())

  @@unique([key, version])
}

/// Mercado M4 (§4.21, §10): how a customer actually pays, recomputed when cash is reconciled.
/// A new row only when the figures change, so the history of rows is the trend over time. Derived data: not audited.
model PaymentBehaviorSnapshot {
  id           String   @id @default(cuid())
  accountId    String
  account      Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  formula      String
  rulesVersion Int
  reason       String
  expectedDays Int?
  avgDelay     Float?
  onTimePct    Float?
  trend        String
  collected    Int
  openTotal    Decimal  @db.Decimal(14, 2)
  metrics      Json
  createdAt    DateTime @default(now())

  @@index([accountId, createdAt])
}

/// Mercado M5 (§11.4): what we remember about a person, only business-relevant things they said or showed.
/// Never psychological profiles or personal labels (§11.5); comm-policy.ts refuses them on save.
/// kind: DECISION_ROLE | VALUES | OBJECTIVE | PROBLEM | TOPIC | PREFERENCE
model PersonNote {
  id             String    @id @default(cuid())
  contactId      String
  contact        Contact   @relation(fields: [contactId], references: [id], onDelete: Cascade)
  kind           String
  statement      String
  evidence       String?
  sourceType     String
  sourceRef      String?
  observedAt     DateTime
  confidence     String    @default("REPORTED")
  capturedByName String
  supersededAt   DateTime?
  createdAt      DateTime  @default(now())

  @@index([contactId])
}

/// Mercado M5 (§11.4, §11.6): a commitment still open — ours (OURS) or theirs (THEIRS).
/// status: OPEN | DONE | DROPPED. Tasks, Journey waits, payment promises and recoveries are read as loops too, not copied here.
model OpenLoop {
  id             String    @id @default(cuid())
  side           String
  what           String
  dueAt          DateTime?
  accountId      String?
  account        Account?  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  contactId      String?
  contact        Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  dealId         String?
  explorationId  String?
  status         String    @default("OPEN")
  closedAt       DateTime?
  closedNote     String?
  closedByName   String?
  sourceType     String
  sourceRef      String?
  observedAt     DateTime
  capturedByName String
  createdAt      DateTime  @default(now())

  @@index([accountId, status])
  @@index([contactId, status])
}

/// Mercado M5 (§11.12): a message prepared through the communication policy, with what it was built from.
/// SOLU never sends it: a person reviews, edits and sends it, then records it here (human-review gate).
/// status: DRAFT | SENT | DISCARDED
model PreparedMessage {
  id                  String    @id @default(cuid())
  purpose             String
  audienceRole        String?
  channel             String
  contactId           String?
  contact             Contact?  @relation(fields: [contactId], references: [id], onDelete: SetNull)
  accountId           String?
  account             Account?  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  draft               String
  finalText           String?
  sourceContextIds    String[]
  factsUsed           Json
  inferencesUsed      Json
  tonePolicy          String    @default("carnegie")
  policyVersion       String
  requiresHumanReview Boolean   @default(true)
  checks              Json
  status              String    @default("DRAFT")
  reviewedByName      String?
  reviewedAt          DateTime?
  createdByName       String
  generatedAt         DateTime  @default(now())

  @@index([contactId])
  @@index([accountId])
}

/// Mercado M6: a suggested Need that a person said is not a need (so SOLU stops suggesting it). ref = note:<id> | future:<id>
// ---------- Comercial C1 · Technical Discovery & Functional Assembly (module 10 §4–5) ----------

/// One component of the solution in the Assembly Scope Matrix. "Requested" (what the customer literally asked)
/// and "required for function" (what it needs to actually work) are separate facts; status says what we do about it.
model ScopeLine {
  id                 String   @id @default(cuid())
  dealId             String
  deal               Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  position           Int      @default(0)
  component          String
  code               String?
  manufacturer       String?
  qty                Int      @default(1)
  family             String?
  requested          Boolean  @default(false)
  requiredForFunction Boolean @default(true)
  /// INCLUDED | EXCLUDED | OPTIONAL | CUSTOMER_SUPPLIED | TO_CONFIRM
  status             String   @default("TO_CONFIRM")
  /// EXACT | PROBABLE | MULTIPLE | UNKNOWN — uncertainty is kept, never rounded up
  identity           String   @default("UNKNOWN")
  /// OEM_NEW | NEW | USED | REFURBISHED | ANY
  condition          String?
  alternativesAllowed Boolean @default(false)
  note               String?
  source             String?
  confirmationId     String?
  confirmation       ScopeConfirmation? @relation(fields: [confirmationId], references: [id], onDelete: SetNull)
  createdByName      String
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  facts              TechnicalFact[]

  @@index([dealId])
}

/// A technical fact about a scope line (nameplate value, spec). Versioned: a correction supersedes, never overwrites.
model TechnicalFact {
  id             String    @id @default(cuid())
  dealId         String
  deal           Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  scopeLineId    String?
  scopeLine      ScopeLine? @relation(fields: [scopeLineId], references: [id], onDelete: Cascade)
  key            String
  value          String
  /// CONFIRMED (seen on nameplate/document) | REPORTED (someone said it) | HYPOTHESIS (inferred)
  state          String    @default("REPORTED")
  source         String
  evidence       String?
  recordedByName String
  createdAt      DateTime  @default(now())
  supersededAt   DateTime?

  @@index([dealId])
  @@index([scopeLineId])
}

/// What the customer confirmed about the scope (who, how, when, in their words). Resolves ambiguous terms and
/// covers excluded / customer-supplied lines.
model ScopeConfirmation {
  id             String    @id @default(cuid())
  dealId         String
  deal           Deal      @relation(fields: [dealId], references: [id], onDelete: Cascade)
  text           String
  confirmedBy    String
  channel        String
  confirmedAt    DateTime
  terms          String[]  @default([])
  recordedByName String
  createdAt      DateTime  @default(now())
  lines          ScopeLine[]

  @@index([dealId])
}

/// Evidenced, versioned relationship between two products (by code or name). Never an automatic AI equivalence.
model ProductRelationship {
  id             String    @id @default(cuid())
  fromKey        String
  fromLabel      String
  /// PART_OF | ASSEMBLED_WITH | DRIVES | REQUIRES | MATES_WITH | OPTIONAL_WITH | CUSTOMER_REUSES | SOLD_AS_ASSEMBLY | SOLD_SEPARATELY
  kind           String
  toKey          String
  toLabel        String
  evidence       String
  recordedByName String
  createdAt      DateTime  @default(now())
  supersededAt   DateTime?

  @@index([fromKey])
  @@index([toKey])
}

model NeedDismissal {
  id        String   @id @default(cuid())
  ref       String   @unique
  accountId String
  note      String?
  byName    String
  createdAt DateTime @default(now())
}

/// Comercial C2 (v1.1 §45): a request to present/accept a quote version whose projected Eságara is below the policy threshold.
/// The economics the approver saw are frozen in `snapshot`; decisions are never edited, only appended to `history`.
/// status: REQUESTED | APPROVED | REJECTED | RETURNED | EXPIRED
model EsagaraException {
  id              String    @id @default(cuid())
  quoteId         String
  quote           Quote     @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  dealId          String
  accountId       String
  currency        String    @default("USD")
  saleAmount      Decimal   @db.Decimal(14, 2)
  esagaraAmount   Decimal   @db.Decimal(14, 2)
  esagaraPct      Decimal   @db.Decimal(7, 2)
  thresholdPct    Decimal   @db.Decimal(7, 2)
  policyVersion   Int
  reasonCode      String
  narrative       String
  expectedBenefit String
  scope           String
  alternatives    String?
  snapshot        Json
  status          String    @default("REQUESTED")
  requestedById   String
  requestedByName String
  requestedAt     DateTime  @default(now())
  decidedById     String?
  decidedByName   String?
  decidedAt       DateTime?
  comments        String?
  history         Json      @default("[]")

  @@index([status])
  @@index([quoteId])
  @@index([accountId])
}